  {
   "id": "e323",
   "type": "text",
   "x": 1260,
   "y": 2535.0,
   "width": 484.0,
   "height": 200.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
