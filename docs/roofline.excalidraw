   "updated": 1,
   "link": null,
   "locked": false,
   "text": "CASE A: MEMORY-BOUND (AI = 10, toy GPU)\nceiling = 10 x 500 = 5 TFLOPS  (compute has 100)",
   "originalText": "CASE A: MEMORY-BOUND (AI = 10, toy GPU)\nceiling = 10 x 500 = 5 TFLOPS  (compute has 100)",
   "fontSize": 17,
