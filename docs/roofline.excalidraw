   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Option 2: fewer bytes (BETTER)\n10 FLOP / 1 B  ->  10 FLOP / 0.25 B\nAI = 40, 40 x 500 = 20 TFLOPS (4x)\nsame GPU",
   "originalText": "Option 2: fewer bytes (BETTER)\n10 FLOP / 1 B  ->  10 FLOP / 0.25 B\nAI = 40, 40 x 500 = 20 TFLOPS (4x)\nsame GPU",
