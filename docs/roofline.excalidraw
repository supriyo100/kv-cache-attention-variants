   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Sliding window\n128K KV -> 8K KV = 16x fewer bytes\nTPOT down 16x (T term); bytes AND FLOPs\nboth /16, so attention AI stays H_q/H_kv",
   "originalText": "Sliding window\n128K KV -> 8K KV = 16x fewer bytes\nTPOT down 16x (T term); bytes AND FLOPs\nboth /16, so attention AI stays H_q/H_kv",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "center",
