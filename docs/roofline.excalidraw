   "versionNonce": 595251419,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ONE LAYER, ONE NEW TOKEN, CONTEXT T\nFLOPs ~ 4 * H_q * d_h * T\n(QK^T: 2*H_q*d_h*T  +  AV: 2*H_q*d_h*T)",
   "originalText": "ONE LAYER, ONE NEW TOKEN, CONTEXT T\nFLOPs ~ 4 * H_q * d_h * T\n(QK^T: 2*H_q*d_h*T  +  AV: 2*H_q*d_h*T)",
   "fontSize": 16,
   "fontFamily": 3,
