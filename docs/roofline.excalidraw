   "link": null,
   "locked": false
  },
  {
   "id": "e276",
   "type": "text",
   "x": 1230,
   "y": 1765.0,
   "width": 427.0,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 951868678,
   "version": 1,
   "versionNonce": 699249954,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Real ridges: A100 312 TFLOPS / 1.555 TB/s = 200\nH100 SXM 989 TFLOPS / 3.35 TB/s = 295\nNew GPUs add FLOPs faster than bandwidth ->\nridge rises -> decode gets MORE memory-bound.",
   "originalText": "Real ridges: A100 312 TFLOPS / 1.555 TB/s = 200\nH100 SXM 989 TFLOPS / 3.35 TB/s = 295\nNew GPUs add FLOPs faster than bandwidth ->\nridge rises -> decode gets MORE memory-bound.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e275",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e277",
   "type": "text",
   "x": 1220,
   "y": 1930,
   "width": 445.0,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1315393613,
   "version": 1,
   "versionNonce": 2090275229,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Example: 1000 TFLOPS / 1.8 TB/s -> ridge ~ 556.\nAI = 50 -> P = 50 x 1.8 = 90 TFLOPS (9% of peak).",
   "originalText": "Example: 1000 TFLOPS / 1.8 TB/s -> ridge ~ 556.\nAI = 50 -> P = 50 x 1.8 = 90 TFLOPS (9% of peak).",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e278",
   "type": "text",
   "x": 0,
   "y": 2000,
   "width": 866.4000000000001,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1085667076,
   "version": 1,
   "versionNonce": 1301670753,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "4. Why decode attention is memory-bound: AI = H_q / H_kv",
   "originalText": "4. Why decode attention is memory-bound: AI = H_q / H_kv",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
