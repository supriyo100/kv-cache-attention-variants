   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TRADE-OFF: batching needs B x KV bytes of VRAM\n(see vram_budget_a100.excalidraw). Capacity, not\ncompute, caps B in long-context serving.",
   "originalText": "TRADE-OFF: batching needs B x KV bytes of VRAM\n(see vram_budget_a100.excalidraw). Capacity, not\ncompute, caps B in long-context serving.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e324",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
