  {
   "id": "e300",
   "type": "text",
   "x": 1570,
   "y": 2290.0,
   "width": 512.8,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
