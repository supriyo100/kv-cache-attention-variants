   "locked": false
  },
  {
   "id": "e325",
   "type": "text",
   "x": 1260,
   "y": 2845.0,
   "width": 464.79999999999995,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
