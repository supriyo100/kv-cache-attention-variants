   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "FP8 KV instead of BF16\n1 GB read for 10 GFLOP: AI = 10\n0.5 GB read, 10 GFLOP: AI = 20\nceiling doubles (S: 2 -> 1)",
   "originalText": "FP8 KV instead of BF16\n1 GB read for 10 GFLOP: AI = 10\n0.5 GB read, 10 GFLOP: AI = 20\nceiling doubles (S: 2 -> 1)",
