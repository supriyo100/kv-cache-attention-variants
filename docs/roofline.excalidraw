   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Option 1: more bandwidth\n500 -> 1000 GB/s:\n10 x 1000 = 10 TFLOPS (2x)\nstill memory-bound",
   "originalText": "Option 1: more bandwidth\n500 -> 1000 GB/s:\n10 x 1000 = 10 TFLOPS (2x)\nstill memory-bound",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e331",
   "lineHeight": 1.25,
   "autoResize": true
  },
