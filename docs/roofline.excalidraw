   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "CASE B: COMPUTE-BOUND (AI = 1000)\nmem could feed 1000 x 500 = 500 TFLOPS; GPU has 100",
   "originalText": "CASE B: COMPUTE-BOUND (AI = 1000)\nmem could feed 1000 x 500 = 500 TFLOPS; GPU has 100",
