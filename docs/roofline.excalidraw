  {
   "id": "e274",
   "type": "text",
   "x": 1230,
   "y": 1575.0,
   "width": 445.0,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1632072836,
   "version": 1,
   "versionNonce": 1919876317,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Even MQA (AI=32) reaches only 32/200 = 16% of the\nA100 ridge: decode attention stays memory-bound.\nGQA/MQA/FP8-KV move the point RIGHT (P1->P2->P3)\nso the same HBM feeds more FLOPs per second.",
   "originalText": "Even MQA (AI=32) reaches only 32/200 = 16% of the\nA100 ridge: decode attention stays memory-bound.\nGQA/MQA/FP8-KV move the point RIGHT (P1->P2->P3)\nso the same HBM feeds more FLOPs per second.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e273",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e275",
   "type": "rectangle",
   "x": 1220,
   "y": 1750,
   "width": 457.0,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#b2f2bb",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
