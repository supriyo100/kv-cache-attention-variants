   "seed": 1926349600,
   "version": 1,
   "versionNonce": 1668450042,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Weight GEMV in decode (batch B tokens):\nFLOPs = 2*B*d_in*d_out, bytes = 2*d_in*d_out (FP16 W)\n-> AI = B.  B=1 -> AI 1.\nBatching raises AI: it reuses each weight read.",
   "originalText": "Weight GEMV in decode (batch B tokens):\nFLOPs = 2*B*d_in*d_out, bytes = 2*d_in*d_out (FP16 W)\n-> AI = B.  B=1 -> AI 1.\nBatching raises AI: it reuses each weight read.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e299",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e301",
   "type": "text",
   "x": 0,
   "y": 2430,
   "width": 1189.8000000000002,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 331671597,
   "version": 1,
   "versionNonce": 2017570883,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "5. Batching rescues weight matmuls: AI = B (A100: ridge 200, roof 312 TFLOPS)",
   "originalText": "5. Batching rescues weight matmuls: AI = B (A100: ridge 200, roof 312 TFLOPS)",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
