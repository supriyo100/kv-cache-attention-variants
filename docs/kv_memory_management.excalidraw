   "roundness": null,
   "seed": 1201546738,
   "version": 1,
   "versionNonce": 1917176626,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Contrast (contiguous): [A][FREE 2][B][FREE 3][C] -> a 4-unit request fails\nalthough 5 units are free. Here: 2 free blocks serve a 2-block request.",
   "originalText": "Contrast (contiguous): [A][FREE 2][B][FREE 3][C] -> a 4-unit request fails\nalthough 5 units are free. Here: 2 free blocks serve a 2-block request.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e288",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e290",
