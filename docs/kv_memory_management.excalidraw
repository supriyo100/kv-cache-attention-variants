   "seed": 1880074284,
   "version": 1,
   "versionNonce": 1757400422,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key insight: \"logical continuity != physical continuity\". Scattered free blocks become usable, so external\nfragmentation (almost) disappears. Internal waste does NOT vanish, it becomes bounded: < P tokens per sequence.",
   "originalText": "Key insight: \"logical continuity != physical continuity\". Scattered free blocks become usable, so external\nfragmentation (almost) disappears. Internal waste does NOT vanish, it becomes bounded: < P tokens per sequence.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e60",
   "lineHeight": 1.25,
   "autoResize": true
  },
