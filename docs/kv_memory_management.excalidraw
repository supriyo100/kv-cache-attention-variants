   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Paging does NOT reduce the mathematical KV size M = 2 L B T H_kv d_h S.\nGQA / MLA / quantization shrink it; paging only stops it from being wasted.",
   "originalText": "Paging does NOT reduce the mathematical KV size M = 2 L B T H_kv d_h S.\nGQA / MLA / quantization shrink it; paging only stops it from being wasted.",
