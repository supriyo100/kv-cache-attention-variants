  {
   "id": "e284",
   "type": "text",
   "x": 300,
   "y": 3386.0,
   "width": 457.59999999999997,
   "height": 17.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
