   "link": null,
   "locked": false
  },
  {
   "id": "e390",
   "type": "text",
   "x": 1410,
   "y": 4463.0,
   "width": 716.8000000000001,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
