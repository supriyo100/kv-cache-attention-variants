   "autoResize": true
  },
  {
   "id": "e291",
   "type": "text",
   "x": 0,
   "y": 3550.0,
   "width": 1033.6000000000001,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1803885801,
   "version": 1,
   "versionNonce": 961059551,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A request's blocks may be anywhere. E needs 3 blocks; the free pool [2, 5, 8] is not contiguous - it does not matter.",
   "originalText": "A request's blocks may be anywhere. E needs 3 blocks; the free pool [2, 5, 8] is not contiguous - it does not matter.",
