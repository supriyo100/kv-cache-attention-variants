   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "lookup for token position pos:\n  page   = pos // 16\n  offset = pos %  16\n  phys   = block_table[A][page]\n  K[...] = k_cache[phys, offset]\nk_cache: [num_blocks, 16, H_kv, d_h]\ne.g. pos = 50 -> page 3, offset 2\n     block_table[A][3] = 51\n     -> k_cache[51, 2]",
   "originalText": "lookup for token position pos:\n  page   = pos // 16\n  offset = pos %  16\n  phys   = block_table[A][page]\n  K[...] = k_cache[phys, offset]\nk_cache: [num_blocks, 16, H_kv, d_h]\ne.g. pos = 50 -> page 3, offset 2\n     block_table[A][3] = 51\n     -> k_cache[51, 2]",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
