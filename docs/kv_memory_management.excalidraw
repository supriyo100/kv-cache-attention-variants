   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Measured on older contiguous systems: only 20.4-38.2% of KV memory held real token states.\nvLLM: waste < 4% (only the last partial block); 2-4x throughput vs FasterTransformer / Orca.",
   "originalText": "Measured on older contiguous systems: only 20.4-38.2% of KV memory held real token states.\nvLLM: waste < 4% (only the last partial block); 2-4x throughput vs FasterTransformer / Orca.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
