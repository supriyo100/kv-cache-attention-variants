   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "e289",
   "type": "text",
   "x": 1460,
   "y": 3268.0,
   "width": 655.2,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
