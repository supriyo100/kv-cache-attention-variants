   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key insight: waste < P per sequence, regardless of how long it grows. A 100K-token sequence wastes at\nmost 15 slots (P = 16). That is what \"near-zero waste\" means: not literally zero, just bounded.",
   "originalText": "Key insight: waste < P per sequence, regardless of how long it grows. A 100K-token sequence wastes at\nmost 15 slots (P = 16). That is what \"near-zero waste\" means: not literally zero, just bounded.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e97",
   "lineHeight": 1.25,
   "autoResize": true
  },
