   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "e287",
   "type": "text",
   "x": 1460,
   "y": 3153.0,
   "width": 796.0000000000001,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2023317399,
   "version": 1,
   "versionNonce": 1992455312,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key insight: the allocator does not care that free blocks are scattered.\nfree list -> E gets FREE block 2, FREE block 7. Physical contiguity is no longer required.",
   "originalText": "Key insight: the allocator does not care that free blocks are scattered.\nfree list -> E gets FREE block 2, FREE block 7. Physical contiguity is no longer required.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e286",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e288",
   "type": "rectangle",
   "x": 1450,
   "y": 3253.0,
   "width": 685.2,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffc9c9",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 557470198,
