   "versionNonce": 752002366,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Trade-off: paging fixes allocation, not size. Total KV is still M = 2 L B T H_kv d_h S.\nDuplication is a SEPARATE problem: only prefix sharing removes it.",
   "originalText": "Trade-off: paging fixes allocation, not size. Total KV is still M = 2 L B T H_kv d_h S.\nDuplication is a SEPARATE problem: only prefix sharing removes it.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e62",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e64",
   "type": "text",
   "x": 0,
   "y": 878.0,
   "width": 1156.0,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#6741d9",
   "backgroundColor": "transparent",
