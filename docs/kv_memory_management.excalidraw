   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Problem: copying a large KV cache mid-generation is exactly what you cannot afford;\nand it needs a bigger contiguous hole that may not exist (external fragmentation).",
   "originalText": "Problem: copying a large KV cache mid-generation is exactly what you cannot afford;\nand it needs a bigger contiguous hole that may not exist (external fragmentation).",
