   "locked": false
  },
  {
   "id": "e388",
   "type": "text",
   "x": 1410,
   "y": 4308.0,
   "width": 734.4000000000001,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1792319766,
   "version": 1,
   "versionNonce": 1908524496,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key insight: duplication is solved by sharing, not by paging itself.\nvLLM hashes block contents; SGLang RadixAttention uses a radix tree.\nWith prefix caching, refcount 0 = \"free but still cached\": the block sits in an LRU\nevictor and can still be hit until it is reallocated.",
   "originalText": "Key insight: duplication is solved by sharing, not by paging itself.\nvLLM hashes block contents; SGLang RadixAttention uses a radix tree.\nWith prefix caching, refcount 0 = \"free but still cached\": the block sits in an LRU\nevictor and can still be hit until it is reallocated.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e387",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e389",
   "type": "rectangle",
   "x": 1400,
   "y": 4448.0,
   "width": 746.8000000000001,
   "height": 70.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffc9c9",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 844145915,
