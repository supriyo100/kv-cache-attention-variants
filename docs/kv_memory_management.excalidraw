  {
   "id": "e61",
   "type": "text",
   "x": 10,
   "y": 805.0,
   "width": 980.8000000000001,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
