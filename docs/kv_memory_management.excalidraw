   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "8  Block-size trade-off: 4 vs 16 vs 256 tokens",
   "originalText": "8  Block-size trade-off: 4 vs 16 vs 256 tokens",
