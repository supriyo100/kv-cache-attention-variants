   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "blocks(T) = ceil(T / P)        waste = P*blocks - T  <  P\nmetadata = O(T / P) table entries per sequence",
   "originalText": "blocks(T) = ceil(T / P)        waste = P*blocks - T  <  P\nmetadata = O(T / P) table entries per sequence",
