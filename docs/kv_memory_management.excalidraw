  {
   "id": "e386",
   "type": "text",
   "x": 0,
   "y": 4338.0,
   "width": 781.6,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 928094289,
   "version": 1,
   "versionNonce": 1409843281,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "no sharing:   100 requests x 256 MiB prefix (2048 tok x 128 KiB) = 25 GiB\nwith sharing:  1 set of blocks = 256 MiB  + 100 small block tables pointing at it",
   "originalText": "no sharing:   100 requests x 256 MiB prefix (2048 tok x 128 KiB) = 25 GiB\nwith sharing:  1 set of blocks = 256 MiB  + 100 small block tables pointing at it",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e387",
   "type": "rectangle",
   "x": 1400,
