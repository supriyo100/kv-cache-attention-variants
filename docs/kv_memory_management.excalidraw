   "versionNonce": 1066600998,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "+ unknown final length: KV(T) grows with T  ->  allocator must grow dynamically  ->  dynamic block allocation = paged KV",
   "originalText": "+ unknown final length: KV(T) grows with T  ->  allocator must grow dynamically  ->  dynamic block allocation = paged KV",
