   "roundness": null,
   "seed": 1088099803,
   "version": 1,
   "versionNonce": 660959058,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Copy-on-write: a request appending into a block with refcount > 1 first copies it\n(refcount - 1, new private block), so other holders are untouched.",
   "originalText": "Copy-on-write: a request appending into a block with refcount > 1 first copies it\n(refcount - 1, new private block), so other holders are untouched.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e389",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e391",
