   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "BlockSize <-> Fragmentation <-> Metadata <-> Kernel efficiency. Same 33-token sequence, 1 slot = 4 px.",
   "originalText": "BlockSize <-> Fragmentation <-> Metadata <-> Kernel efficiency. Same 33-token sequence, 1 slot = 4 px.",
