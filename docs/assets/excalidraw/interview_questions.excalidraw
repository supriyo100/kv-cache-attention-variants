   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY FORMULAS\ntheta_i = base^(-2i/d) ; rotate pair i by m*theta_i\n<R_m q, R_n k> = q^T R_{n-m} k  (relative position)\nlambda_0 = 6.3 tok ; lambda_63 = 54.4K (base 1e4), 2.56M (5e5)\nPI: m/s ; NTK: base' = base*s^(d/(d-2)) ; code q*cos+rot_half(q)*sin",
   "originalText": "KEY FORMULAS\ntheta_i = base^(-2i/d) ; rotate pair i by m*theta_i\n<R_m q, R_n k> = q^T R_{n-m} k  (relative position)\nlambda_0 = 6.3 tok ; lambda_63 = 54.4K (base 1e4), 2.56M (5e5)\nPI: m/s ; NTK: base' = base*s^(d/(d-2)) ; code q*cos+rot_half(q)*sin",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e131",
   "lineHeight": 1.25,
   "autoResize": true
