   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY FORMULAS\nexternal: 2+3 GB free, no 4 GB hole | internal: 18 tok -> 32 slots, 14 wasted\n32K reserve 4.295 GB -> 12 reqs ; paged 1.2K = 157.3 MB -> 330 reqs\ngrow: 7 blocks -> #113 -> #129, no copy | waste <= (P-1)*128 KiB\nstatic 1570/4000 = 39% | CoW: 362 vs 1,112 MiB | 1M/4 GPUs = 250K",
   "originalText": "KEY FORMULAS\nexternal: 2+3 GB free, no 4 GB hole | internal: 18 tok -> 32 slots, 14 wasted\n32K reserve 4.295 GB -> 12 reqs ; paged 1.2K = 157.3 MB -> 330 reqs\ngrow: 7 blocks -> #113 -> #129, no copy | waste <= (P-1)*128 KiB\nstatic 1570/4000 = 39% | CoW: 362 vs 1,112 MiB | 1M/4 GPUs = 250K",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e308",
   "lineHeight": 1.25,
   "autoResize": true
