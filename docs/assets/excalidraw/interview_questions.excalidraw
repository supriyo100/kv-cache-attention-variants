   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY FORMULAS\nchunk 512 tok = 8.2 TFLOP ~ 26 ms @312T ; 32K prefill ~ 1.7 s\nspec-dec E = (1-a^(k+1))/(1-a) ; a=.8, k=4 -> 3.36\nFP8 KV: S 2->1 = 2x capacity ; window+4 sinks: M ~ W\nTTFT = queue + prefill ; TPOT = decode step",
   "originalText": "KEY FORMULAS\nchunk 512 tok = 8.2 TFLOP ~ 26 ms @312T ; 32K prefill ~ 1.7 s\nspec-dec E = (1-a^(k+1))/(1-a) ; a=.8, k=4 -> 3.36\nFP8 KV: S 2->1 = 2x capacity ; window+4 sinks: M ~ W\nTTFT = queue + prefill ; TPOT = decode step",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e230",
   "lineHeight": 1.25,
   "autoResize": true
