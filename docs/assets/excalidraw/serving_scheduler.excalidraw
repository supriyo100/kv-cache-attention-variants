   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Static: busy slot-time = 20+500+50+1000 = 1,570\nof 4 x 1000 = 4,000 -> ~39% useful. The GPU\nwaits for D while A, B and C sit finished.",
   "originalText": "Static: busy slot-time = 20+500+50+1000 = 1,570\nof 4 x 1000 = 4,000 -> ~39% useful. The GPU\nwaits for D while A, B and C sit finished.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
