  {
   "id": "e204",
   "type": "text",
   "x": 1410,
   "y": 2630.0,
   "width": 549.6,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1679982649,
   "version": 1,
   "versionNonce": 1527919545,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A good scheduler estimates KV_required and whether the request\ncan be SUSTAINED. It cannot reserve the theoretical max (that\nbrings back the 32K-per-request waste): it needs a token/block\nbudget with a watermark, then handles overflow by preemption.",
   "originalText": "A good scheduler estimates KV_required and whether the request\ncan be SUSTAINED. It cannot reserve the theoretical max (that\nbrings back the 32K-per-request waste): it needs a token/block\nbudget with a watermark, then handles overflow by preemption.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e203",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e205",
   "type": "text",
   "x": 0,
   "y": 2785,
   "width": 1159.0,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
