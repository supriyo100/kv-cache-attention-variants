   "versionNonce": 428035153,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "6. Static vs continuous batching (A = 20, B = 500, C = 50, D = 1000 tokens)",
   "originalText": "6. Static vs continuous batching (A = 20, B = 500, C = 50, D = 1000 tokens)",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e206",
   "type": "text",
   "x": 0,
   "y": 2835,
   "width": 1290.3999999999999,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1026567497,
   "version": 1,
   "versionNonce": 1909136608,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TIME AXIS IS A SQUARE-ROOT SCALE: bar length = 40 px x sqrt(tokens). Real ratio D : A = 50 : 1, but drawn about 7 : 1 so all four fit.",
   "originalText": "TIME AXIS IS A SQUARE-ROOT SCALE: bar length = 40 px x sqrt(tokens). Real ratio D : A = 50 : 1, but drawn about 7 : 1 so all four fit.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
