   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Continuous: E, F, G, H... enter as slots free up\n(E, F, G, H lengths are illustrative). With a queue\nthe slots stay full. Needs per-iteration KV alloc/free,\nwhich a paged allocator gives naturally.",
   "originalText": "Continuous: E, F, G, H... enter as slots free up\n(E, F, G, H lengths are illustrative). With a queue\nthe slots stay full. Needs per-iteration KV alloc/free,\nwhich a paged allocator gives naturally.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e281",
   "lineHeight": 1.25,
   "autoResize": true
  },
