   "locked": false
  },
  {
   "id": "e362",
   "type": "text",
   "x": 1110,
   "y": 3365.0,
   "width": 551.1999999999999,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
