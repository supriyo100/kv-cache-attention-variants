   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "GQA asks: how many KV heads?          knob = G   (ratio H/G)\nMLA asks: how many numbers per token?  knob = d_c (+ d_R)\nMLA is NOT 'GQA with fewer heads': it changes WHAT is cached.",
   "originalText": "GQA asks: how many KV heads?          knob = G   (ratio H/G)\nMLA asks: how many numbers per token?  knob = d_c (+ d_R)\nMLA is NOT 'GQA with fewer heads': it changes WHAT is cached.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e665",
   "lineHeight": 1.25,
   "autoResize": true
  },
