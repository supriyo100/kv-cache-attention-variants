   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "GQA vs MLA at equal budget: MLA's 576 elements per\ntoken per layer = GQA with 2.25 KV groups (d_h=128),\nbut MLA keeps 128 distinct per-head K/V views.",
   "originalText": "GQA vs MLA at equal budget: MLA's 576 elements per\ntoken per layer = GQA with 2.25 KV groups (d_h=128),\nbut MLA keeps 128 distinct per-head K/V views.",
