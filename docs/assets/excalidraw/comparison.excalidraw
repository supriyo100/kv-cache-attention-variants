   "text": "c^KV (512) + k^R (64) = 576 numbers: this is ALL that sits in HBM per token per layer",
   "originalText": "c^KV (512) + k^R (64) = 576 numbers: this is ALL that sits in HBM per token per layer",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e706",
   "type": "rectangle",
   "x": 1100,
   "y": 5595,
   "width": 880.0,
