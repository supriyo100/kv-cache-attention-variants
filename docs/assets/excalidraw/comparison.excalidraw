   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1837092102,
   "version": 1,
   "versionNonce": 1005347509,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "7. Two different knobs: FEWER KV heads (GQA, MQA) vs a SMALLER KV representation (MLA)",
   "originalText": "7. Two different knobs: FEWER KV heads (GQA, MQA) vs a SMALLER KV representation (MLA)",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
