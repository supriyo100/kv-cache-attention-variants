  {
   "id": "e377",
   "type": "text",
   "x": 2043.5,
   "y": 3751.25,
   "width": 913.0,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
