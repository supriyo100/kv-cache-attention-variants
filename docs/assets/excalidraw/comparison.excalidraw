   "roundness": null,
   "seed": 537834622,
   "version": 1,
   "versionNonce": 79348129,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MHA -> MLA (harder):  K ~ W^UK c,  V ~ W^UV c,  c = W^D h   (low-rank factorisation)\njoint SVD + partial-RoPE handling; Llama-2-7B: 92.19% KV cut, ~0.5% LongBench drop (arXiv 2502.14837)",
   "originalText": "MHA -> MLA (harder):  K ~ W^UK c,  V ~ W^UV c,  c = W^D h   (low-rank factorisation)\njoint SVD + partial-RoPE handling; Llama-2-7B: 92.19% KV cut, ~0.5% LongBench drop (arXiv 2502.14837)",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e376",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e378",
