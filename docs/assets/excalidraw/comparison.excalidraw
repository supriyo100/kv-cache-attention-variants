   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KV/token (toy) = 2*32*H_kv*64*2 B: MHA 262,144 B = 256 KiB.   100K tokens: 26.2 / 13.1 / 6.55 / 3.28 / 0.82 GB.\nLlama-3-8B: 2*32*8*128*2 B = 131,072 B = 128 KiB; 8K tokens = 1 GiB per sequence.\nMLA: 576 * 2 B * 60 layers = 69,120 B (67.5 KiB) per token vs 3.75 MiB if it were MHA (32,768 * 2 B * 60).",
   "originalText": "KV/token (toy) = 2*32*H_kv*64*2 B: MHA 262,144 B = 256 KiB.   100K tokens: 26.2 / 13.1 / 6.55 / 3.28 / 0.82 GB.\nLlama-3-8B: 2*32*8*128*2 B = 131,072 B = 128 KiB; 8K tokens = 1 GiB per sequence.\nMLA: 576 * 2 B * 60 layers = 69,120 B (67.5 KiB) per token vs 3.75 MiB if it were MHA (32,768 * 2 B * 60).",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e273",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e275",
   "type": "rectangle",
   "x": 1750,
   "y": 1935,
   "width": 664.0,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#b2f2bb",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
