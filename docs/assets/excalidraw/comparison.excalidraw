   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "LEVEL 3  fundamental change (substantial training)\nTransformer -> hybrid attention/SSM\nfull-KV layers -> cross-layer sharing\nchanges the learned computation graph",
   "originalText": "LEVEL 3  fundamental change (substantial training)\nTransformer -> hybrid attention/SSM\nfull-KV layers -> cross-layer sharing\nchanges the learned computation graph",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e372",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
