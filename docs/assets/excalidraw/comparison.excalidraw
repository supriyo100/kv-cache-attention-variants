   "link": null,
   "locked": false
  },
  {
   "id": "e375",
   "type": "text",
   "x": 2079.5,
   "y": 3651.25,
   "width": 841.0,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 745179022,
   "version": 1,
   "versionNonce": 1725887396,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MHA -> GQA (cheap):  K_g = (1/n) * sum_{i in g} K_i,   V_g = (1/n) * sum_{i in g} V_i\nmean-pool the heads of each group, then uptrain on ~5% of pretrain compute (arXiv 2305.13245)",
   "originalText": "MHA -> GQA (cheap):  K_g = (1/n) * sum_{i in g} K_i,   V_g = (1/n) * sum_{i in g} V_i\nmean-pool the heads of each group, then uptrain on ~5% of pretrain compute (arXiv 2305.13245)",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e374",
   "lineHeight": 1.25,
   "autoResize": true
  },
