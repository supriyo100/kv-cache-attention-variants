   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TRADE-OFF: GQA/MQA trade quality for bytes along a curve;\nhybrids trade exact retrieval for state; MLA pays in\ncompute (up-projections), a decoupled-RoPE path and\nretraining complexity instead of quality.",
   "originalText": "TRADE-OFF: GQA/MQA trade quality for bytes along a curve;\nhybrids trade exact retrieval for state; MLA pays in\ncompute (up-projections), a decoupled-RoPE path and\nretraining complexity instead of quality.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e361",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
