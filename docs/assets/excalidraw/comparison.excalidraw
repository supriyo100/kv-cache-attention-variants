   "link": null,
   "locked": false
  },
  {
   "id": "e379",
   "type": "text",
   "x": 1910,
   "y": 3855.0,
   "width": 751.0,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1574278140,
   "version": 1,
   "versionNonce": 1085883652,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Efficiency is not free: pick the level your team can pay for.\nStart at Level 1; go to Level 2 when KV does not fit; Level 3 only for a new model.",
   "originalText": "Efficiency is not free: pick the level your team can pay for.\nStart at Level 1; go to Level 2 when KV does not fit; Level 3 only for a new model.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e378",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e380",
   "type": "text",
   "x": 0,
   "y": 4100,
   "width": 1420.8000000000002,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1183368988,
   "version": 1,
   "versionNonce": 2100349883,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "6. ONE worked example: H = 32, d_h = 128, d_model = H*d_h = 4,096, L = 32 layers, BF16 (2 B)",
   "originalText": "6. ONE worked example: H = 32, d_h = 128, d_model = H*d_h = 4,096, L = 32 layers, BF16 (2 B)",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e381",
   "type": "text",
   "x": 0,
   "y": 4142,
   "width": 1039.0,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 406854725,
   "version": 1,
   "versionNonce": 1104311061,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each small cell = 128 numbers = one head's K or V vector, for ONE token in ONE layer. Count the cells = cache size.",
   "originalText": "Each small cell = 128 numbers = one head's K or V vector, for ONE token in ONE layer. Count the cells = cache size.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
