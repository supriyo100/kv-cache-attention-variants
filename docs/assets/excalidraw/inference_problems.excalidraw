   "updated": 1,
   "link": null,
   "locked": false,
   "text": "FIX: Reserve headroom (e.g. gpu_memory_utilization), size KV pool after profiling peak\nactivations.",
   "originalText": "FIX: Reserve headroom (e.g. gpu_memory_utilization), size KV pool after profiling peak\nactivations.",
