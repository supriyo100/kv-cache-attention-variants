   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "B=8  52.4 GB (> 40 GB!)",
   "originalText": "B=8  52.4 GB (> 40 GB!)",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
