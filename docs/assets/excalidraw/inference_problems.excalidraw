   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHY (math): Perf ~ AI*BW, not P_compute. 2x compute, 1.2x BW -> ~1.2x decode at best.\nAI=10: GPU A (1000 TF, 500 GB/s) = 5 TF; GPU B (500 TF, 1000 GB/s) = 10 TF.",
   "originalText": "WHY (math): Perf ~ AI*BW, not P_compute. 2x compute, 1.2x BW -> ~1.2x decode at best.\nAI=10: GPU A (1000 TF, 500 GB/s) = 5 TF; GPU B (500 TF, 1000 GB/s) = 10 TF.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e234",
   "lineHeight": 1.25,
   "autoResize": true
  },
