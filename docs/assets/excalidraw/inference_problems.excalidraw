   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHY (math): 40 GB = Weights + KV + Activations + Workspace + Runtime + Fragmentation.\nExample: 14 + 10 + 3 + 2 + 2 = 31 GB, so the 'free' 9 GB is not really free.",
   "originalText": "WHY (math): 40 GB = Weights + KV + Activations + Workspace + Runtime + Fragmentation.\nExample: 14 + 10 + 3 + 2 + 2 = 31 GB, so the 'free' 9 GB is not really free.",
