   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM: Even when KV fits, every generated token must read the whole historical K/V\nfrom HBM. Decode becomes memory-bandwidth bound.",
   "originalText": "PROBLEM: Even when KV fits, every generated token must read the whole historical K/V\nfrom HBM. Decode becomes memory-bandwidth bound.",
   "fontSize": 14,
   "fontFamily": 3,
