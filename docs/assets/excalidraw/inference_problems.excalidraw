   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM: Model size, context and concurrency fight for the same HBM. 7B FP16 = 14 GB;\n70B FP16 = 140 GB cannot fit one A100-40GB.",
   "originalText": "PROBLEM: Model size, context and concurrency fight for the same HBM. 7B FP16 = 14 GB;\n70B FP16 = 140 GB cannot fit one A100-40GB.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e181",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
