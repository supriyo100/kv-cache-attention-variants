   "versionNonce": 172954318,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Takeaway: KV cache is a concurrency problem, not merely a context-length problem. Model size <-> context <-> concurrency compete for one\nphysical resource.\nLong context after GQA is still a memory-CAPACITY problem: 64 KiB/token * 1M = 61 GiB.",
   "originalText": "Takeaway: KV cache is a concurrency problem, not merely a context-length problem. Model size <-> context <-> concurrency compete for one\nphysical resource.\nLong context after GQA is still a memory-CAPACITY problem: 64 KiB/token * 1M = 61 GiB.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e189",
   "lineHeight": 1.25,
   "autoResize": true
  },
