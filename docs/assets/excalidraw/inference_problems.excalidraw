   "seed": 346686776,
   "version": 1,
   "versionNonce": 1108819938,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM: KV cache is a CONCURRENCY problem, not only a context problem: a GPU that\nholds one long request cannot hold many.",
   "originalText": "PROBLEM: KV cache is a CONCURRENCY problem, not only a context problem: a GPU that\nholds one long request cannot hold many.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e151",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e153",
   "type": "rectangle",
   "x": 1600,
   "y": 1611.0,
   "width": 760,
   "height": 88.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffec99",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 49597690,
   "version": 1,
   "versionNonce": 440695868,
   "isDeleted": false,
   "boundElements": [
    {
     "type": "text",
     "id": "e154"
    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "e154",
   "type": "text",
   "x": 1610,
   "y": 1628.75,
   "width": 734.8,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2042225962,
   "version": 1,
   "versionNonce": 2044449415,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHY (math): KV_total = B * KV_1seq. Per seq 6.55 GB: B=1 6.55 | B=4 26.2 | B=8 52.4 GB.\n A100-40GB minus 14 GB weights leaves 26 GB; B=4 needs 4 x 6.55 = 26.2 GB -> B<=3 even\nbefore runtime overhead (B_max = 3 with ~4 GB overhead).",
   "originalText": "WHY (math): KV_total = B * KV_1seq. Per seq 6.55 GB: B=1 6.55 | B=4 26.2 | B=8 52.4 GB.\n A100-40GB minus 14 GB weights leaves 26 GB; B=4 needs 4 x 6.55 = 26.2 GB -> B<=3 even\nbefore runtime overhead (B_max = 3 with ~4 GB overhead).",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e153",
   "lineHeight": 1.25,
   "autoResize": true
  },
