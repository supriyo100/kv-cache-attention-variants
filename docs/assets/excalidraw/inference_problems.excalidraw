   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHY (math): M_KV = 2*L*B*T*H_kv*d_h*S. Toy (L=32, d_h=64, FP16): 2*32*32*64*2 = 262,144\n B = 256 KiB/token -> 100K tokens = 26.2 GB at B=1.",
   "originalText": "WHY (math): M_KV = 2*L*B*T*H_kv*d_h*S. Toy (L=32, d_h=64, FP16): 2*32*32*64*2 = 262,144\n B = 256 KiB/token -> 100K tokens = 26.2 GB at B=1.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e127",
   "lineHeight": 1.25,
   "autoResize": true
