   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHY (math): TTFT = queueing + tokenization + prefill (compute). TPOT = decode step = KV\n bytes moved / BW + weights bytes / BW (memory).",
   "originalText": "WHY (math): TTFT = queueing + tokenization + prefill (compute). TPOT = decode step = KV\n bytes moved / BW + weights bytes / BW (memory).",
