   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHY (math): B_max ~ (VRAM - W - overhead) / (2*L*T*H_kv*d_h*S). A100: (40 - 14 - ~4) /\n6.55 GB = ~3 seqs at 100K (toy GQA-8).",
   "originalText": "WHY (math): B_max ~ (VRAM - W - overhead) / (2*L*T*H_kv*d_h*S). A100: (40 - 14 - ~4) /\n6.55 GB = ~3 seqs at 100K (toy GQA-8).",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e183",
   "lineHeight": 1.25,
   "autoResize": true
  },
