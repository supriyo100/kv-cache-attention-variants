   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM: 1,000 users share one 2K-token system prompt; recomputing the same prefix is\nwasteful.",
   "originalText": "PROBLEM: 1,000 users share one 2K-token system prompt; recomputing the same prefix is\nwasteful.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e331",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
