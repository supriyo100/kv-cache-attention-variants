   "locked": false
  },
  {
   "id": "e152",
   "type": "text",
   "x": 1610,
   "y": 1567.0,
   "width": 692.8,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
