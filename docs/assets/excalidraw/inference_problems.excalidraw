   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM: Requests of 37,000 / 4,500 / 19,000 tokens arrive, one finishes, a\n12,000-token one arrives. Contiguous max_len allocation leaves holes: enough free VRAM\nin total, not enough contiguous.",
   "originalText": "PROBLEM: Requests of 37,000 / 4,500 / 19,000 tokens arrive, one finishes, a\n12,000-token one arrives. Contiguous max_len allocation leaves holes: enough free VRAM\nin total, not enough contiguous.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e301",
   "lineHeight": 1.25,
