   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM: GPU B has 2x Tensor FLOPS but only 1.2x memory bandwidth. A memory-bound\ndecode barely improves.",
   "originalText": "PROBLEM: GPU B has 2x Tensor FLOPS but only 1.2x memory bandwidth. A memory-bound\ndecode barely improves.",
