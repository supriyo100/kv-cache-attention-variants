   "versionNonce": 1058240950,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Worked row: tile 1 scores [1, 3]  ->  m = 3,  l = e^-2 + 1 = 1.1353\ntile 2 score [5]  ->  m' = 5,  a = e^-2 = 0.1353,  l = 0.1353 x 1.1353 + 1 = 1.1536\ndirect check: e^-4 + e^-2 + e^0 = 0.0183 + 0.1353 + 1 = 1.1536   (match)",
   "originalText": "Worked row: tile 1 scores [1, 3]  ->  m = 3,  l = e^-2 + 1 = 1.1353\ntile 2 score [5]  ->  m' = 5,  a = e^-2 = 0.1353,  l = 0.1353 x 1.1353 + 1 = 1.1536\ndirect check: e^-4 + e^-2 + e^0 = 0.0183 + 0.1353 + 1 = 1.1536   (match)",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e177",
   "lineHeight": 1.25,
   "autoResize": true
  },
