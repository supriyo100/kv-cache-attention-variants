   "roundness": null,
   "seed": 1588769799,
   "version": 1,
   "versionNonce": 1395718935,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "GQA/MLA/SSM decide how much historical information must exist; PagedAttention decides how that information is allocated and reclaimed;\nFlashAttention decides how efficiently attention consumes it; and the scheduler decides which requests are allowed to occupy the GPU at each iteration.",
   "originalText": "GQA/MLA/SSM decide how much historical information must exist; PagedAttention decides how that information is allocated and reclaimed;\nFlashAttention decides how efficiently attention consumes it; and the scheduler decides which requests are allowed to occupy the GPU at each iteration.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e488",
   "lineHeight": 1.25,
   "autoResize": true
  }
