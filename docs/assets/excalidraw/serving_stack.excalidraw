   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Order matters: does it FIT (steps 1-3)  ->  is memory WASTED (4)  ->  is each piece FAST (5-6)  ->  who RUNS (7)\n->  extreme context (8)  ->  user-visible latency: TTFT (9) and TPOT (10).   Colors = layer that owns the fix (see section 7).",
   "originalText": "Order matters: does it FIT (steps 1-3)  ->  is memory WASTED (4)  ->  is each piece FAST (5-6)  ->  who RUNS (7)\n->  extreme context (8)  ->  user-visible latency: TTFT (9) and TPOT (10).   Colors = layer that owns the fix (see section 7).",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e455",
   "lineHeight": 1.25,
   "autoResize": true
  },
