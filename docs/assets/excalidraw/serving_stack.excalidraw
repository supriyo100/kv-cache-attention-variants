    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "e333",
   "type": "text",
   "x": 2110,
   "y": 2945.0,
   "width": 920.3000000000001,
   "height": 85.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 85014979,
   "version": 1,
   "versionNonce": 1945402620,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Bottleneck MOVES: HBM capacity  ->  NVLink / InfiniBand bandwidth.\nPrefill (ring attention): every layer ships K,V shards around the ring, overlapped with compute.\nDecode: each GPU attends its local shard; only partial (O, m, l) are merged (online-softmax merge)\n- a few KB per layer per step.",
   "originalText": "Bottleneck MOVES: HBM capacity  ->  NVLink / InfiniBand bandwidth.\nPrefill (ring attention): every layer ships K,V shards around the ring, overlapped with compute.\nDecode: each GPU attends its local shard; only partial (O, m, l) are merged (online-softmax merge)\n- a few KB per layer per step.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e332",
   "lineHeight": 1.25,
   "autoResize": true
  },
