  {
   "id": "e331",
   "type": "text",
   "x": 2110,
   "y": 2795.0,
   "width": 677.2,
   "height": 85.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 225012473,
   "version": 1,
   "versionNonce": 180520194,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1M tokens / 4 GPUs = 250K tokens per GPU\nKV per GPU = total / 4  (toy GQA-8: 65.5 GB total -> ~16.4 GB each)\nAttention stays EXACT: every Q must still see every earlier K,V (causal)\n- hence ring / zig-zag sharding.",
   "originalText": "1M tokens / 4 GPUs = 250K tokens per GPU\nKV per GPU = total / 4  (toy GQA-8: 65.5 GB total -> ~16.4 GB each)\nAttention stays EXACT: every Q must still see every earlier K,V (causal)\n- hence ring / zig-zag sharding.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e330",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e332",
   "type": "rectangle",
   "x": 2100,
   "y": 2930,
   "width": 1000,
   "height": 115.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffc9c9",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 570294932,
   "version": 1,
