   "versionNonce": 834374148,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PagedAttention tells the system: KV blocks are here.  The kernel says: I will process those blocks efficiently.\nIn a paged kernel each 16-token KV block can serve as one K/V tile: the block table is the tile iterator\n(tile j -> physical block table[j]), and the online-softmax update from section 2 runs unchanged.",
   "originalText": "PagedAttention tells the system: KV blocks are here.  The kernel says: I will process those blocks efficiently.\nIn a paged kernel each 16-token KV block can serve as one K/V tile: the block table is the tile iterator\n(tile j -> physical block table[j]), and the online-softmax update from section 2 runs unchanged.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e202",
   "lineHeight": 1.25,
   "autoResize": true
  },
