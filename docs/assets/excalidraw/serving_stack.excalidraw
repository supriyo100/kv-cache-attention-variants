  {
   "id": "e203",
   "type": "text",
   "x": 10,
   "y": 2010.0,
   "width": 1041.8500000000001,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
