   "locked": false
  },
  {
   "id": "e487",
   "type": "text",
   "x": 2510,
   "y": 5275.0,
   "width": 406.05,
   "height": 85.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
