   "seed": 1566235066,
   "version": 1,
   "versionNonce": 1624445551,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Neither PagedAttention nor FlashAttention\nshrinks KV or removes the bytes decode must\nread per token - that is the model's job\n(GQA / MLA / quant).",
   "originalText": "Neither PagedAttention nor FlashAttention\nshrinks KV or removes the bytes decode must\nread per token - that is the model's job\n(GQA / MLA / quant).",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e486",
   "lineHeight": 1.25,
   "autoResize": true
  },
