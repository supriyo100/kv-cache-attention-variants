   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A 10 GB KV cache stays 10 GB under FlashAttention - it just reads the pieces efficiently.\nPagedAttention likewise does not shrink it: it only stops you wasting the memory around it.",
   "originalText": "A 10 GB KV cache stays 10 GB under FlashAttention - it just reads the pieces efficiently.\nPagedAttention likewise does not shrink it: it only stops you wasting the memory around it.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e74",
   "lineHeight": 1.25,
   "autoResize": true
  },
