   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Interview line:\nModel decides HOW MUCH.\nCache manager decides LIFECYCLE.\nKernel decides EFFICIENCY.\nScheduler decides WHO RUNS.",
   "originalText": "Interview line:\nModel decides HOW MUCH.\nCache manager decides LIFECYCLE.\nKernel decides EFFICIENCY.\nScheduler decides WHO RUNS.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e484",
   "lineHeight": 1.25,
   "autoResize": true
  },
