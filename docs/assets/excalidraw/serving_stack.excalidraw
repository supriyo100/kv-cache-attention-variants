   "locked": false,
   "text": "O_i accumulator\nB_r x d_h (FP32)",
   "originalText": "O_i accumulator\nB_r x d_h (FP32)",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
