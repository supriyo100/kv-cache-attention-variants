   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Value side: fold W^UV into W^O (a_t,j,i = softmax weights):",
   "originalText": "Value side: fold W^UV into W^O (a_t,j,i = softmax weights):",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e132",
   "type": "text",
   "x": 30,
   "y": 2222.75,
   "width": 993.4,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 324838976,
   "version": 1,
   "versionNonce": 1152379866,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "o_t,i = Σ_j a_t,j,i W^UV_i c^KV_j = W^UV_i ( Σ_j a_t,j,i c^KV_j ) = W^UV_i ô_t,i   ô ∈ R^512\nu_t   = Σ_i W^O_i o_t,i = Σ_i (W^O_i W^UV_i) ô_t,i       W^O_i: 5120×128 → W^O_i W^UV_i: 5120×512",
   "originalText": "o_t,i = Σ_j a_t,j,i W^UV_i c^KV_j = W^UV_i ( Σ_j a_t,j,i c^KV_j ) = W^UV_i ô_t,i   ô ∈ R^512\nu_t   = Σ_i W^O_i o_t,i = Σ_i (W^O_i W^UV_i) ô_t,i       W^O_i: 5120×128 → W^O_i W^UV_i: 5120×512",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e133",
