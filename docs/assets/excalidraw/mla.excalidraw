    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "e114",
   "type": "text",
   "x": 40,
   "y": 1765.75,
   "width": 2706.15,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1326270331,
   "version": 1,
   "versionNonce": 1406529762,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key insight: the only per-token state that must survive to the next decode step is c^KV_t (512) and k^R_t (64) — red boxes. Everything else (k^C, v^C, q) can be regenerated from them, or (section 4) never materialised at all. c^Q only saves activation memory in training; it is not cached.",
   "originalText": "Key insight: the only per-token state that must survive to the next decode step is c^KV_t (512) and k^R_t (64) — red boxes. Everything else (k^C, v^C, q) can be regenerated from them, or (section 4) never materialised at all. c^Q only saves activation memory in training; it is not cached.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e113",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e157",
   "type": "rectangle",
   "x": 0,
   "y": 1882.0,
   "width": 1520.0,
   "height": 675.25,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "#f8f9fa",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
