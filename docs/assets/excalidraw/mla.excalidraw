   "version": 1,
   "versionNonce": 567904180,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Trade-off: GQA works with stock kernels and a cheap MHA→GQA uptrain (mean-pool heads, ~5 % compute);\nMLA needs training from scratch (or invasive conversion) plus custom prefill/decode kernels.",
   "originalText": "Trade-off: GQA works with stock kernels and a cheap MHA→GQA uptrain (mean-pool heads, ~5 % compute);\nMLA needs training from scratch (or invasive conversion) plus custom prefill/decode kernels.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e354",
   "lineHeight": 1.25,
   "autoResize": true
  },
