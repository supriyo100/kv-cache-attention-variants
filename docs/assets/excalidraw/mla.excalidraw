   "versionNonce": 980634927,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "4 · The absorption trick (why decode never builds K, V)",
   "originalText": "4 · The absorption trick (why decode never builds K, V)",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e117",
   "type": "text",
   "x": 30,
   "y": 1954.0,
   "width": 617.8000000000001,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1931732424,
   "version": 1,
   "versionNonce": 1870414235,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Content part of the score for head i, query t, cached token j:",
   "originalText": "Content part of the score for head i, query t, cached token j:",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e118",
   "type": "text",
   "x": 30,
   "y": 1986.5,
   "width": 911.8,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1674971721,
   "version": 1,
   "versionNonce": 2044160092,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "q^C_t,iᵀ k^C_j,i = (W^UQ_i c^Q_t)ᵀ (W^UK_i c^KV_j)      W^UQ_i: 128×1536, W^UK_i: 128×512\n                = c^Q_tᵀ (W^UQ_iᵀ W^UK_i) c^KV_j        middle: 1536×512, position-free\n                = (W^UK_iᵀ q^C_t,i)ᵀ c^KV_j = q̂_t,iᵀ c^KV_j      q̂_t,i ∈ R^512",
   "originalText": "q^C_t,iᵀ k^C_j,i = (W^UQ_i c^Q_t)ᵀ (W^UK_i c^KV_j)      W^UQ_i: 128×1536, W^UK_i: 128×512\n                = c^Q_tᵀ (W^UQ_iᵀ W^UK_i) c^KV_j        middle: 1536×512, position-free\n                = (W^UK_iᵀ q^C_t,i)ᵀ c^KV_j = q̂_t,iᵀ c^KV_j      q̂_t,i ∈ R^512",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
