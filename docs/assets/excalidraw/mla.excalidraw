   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key insight: position lives only in the 64-d RoPE slice, content only in the absorbable part. One SHARED k^R\ncosts 64 numbers; per-head k^R would add 128×64 = 8,192 per token (16× the 512-d latent, 14× the whole 576-element cache) — MQA-style for position.",
   "originalText": "Key insight: position lives only in the 64-d RoPE slice, content only in the absorbable part. One SHARED k^R\ncosts 64 numbers; per-head k^R would add 128×64 = 8,192 per token (16× the 512-d latent, 14× the whole 576-element cache) — MQA-style for position.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e155",
   "lineHeight": 1.25,
   "autoResize": true
