   "locked": false
  },
  {
   "id": "e355",
   "type": "text",
   "x": 1620.0,
   "y": 3687.5,
   "width": 939.0000000000001,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
