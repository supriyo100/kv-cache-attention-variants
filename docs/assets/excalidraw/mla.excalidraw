   "locked": false
  },
  {
   "id": "e353",
   "type": "text",
   "x": 1620.0,
   "y": 3599.0,
   "width": 967.0500000000001,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 179835702,
   "version": 1,
   "versionNonce": 1306051057,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key insight: GQA = head sharing; MLA = learned low-rank compression of the KV state. MLA is not a point\nbetween MHA and MQA on a 1-D 'number of KV heads' axis — it changes what is cached (chatgpt.md §32).",
   "originalText": "Key insight: GQA = head sharing; MLA = learned low-rank compression of the KV state. MLA is not a point\nbetween MHA and MQA on a 1-D 'number of KV heads' axis — it changes what is cached (chatgpt.md §32).",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e352",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e354",
