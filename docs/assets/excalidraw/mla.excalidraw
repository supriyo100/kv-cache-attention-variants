   "locked": false
  },
  {
   "id": "e116",
   "type": "text",
   "x": 24,
   "y": 1900.0,
   "width": 851.0000000000001,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
