  {
   "id": "e350",
   "type": "text",
   "x": 2370.0,
   "y": 3397.75,
   "width": 330.4,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2015090660,
   "version": 1,
   "versionNonce": 36145851,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "every head: its OWN K_i = W^UK_i c\ncache ∝ d_c + d_R, not n_h",
   "originalText": "every head: its OWN K_i = W^UK_i c\ncache ∝ d_c + d_R, not n_h",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e351",
   "type": "text",
   "x": 1610.0,
   "y": 3467.75,
   "width": 738.4,
   "height": 106.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1362448472,
   "version": 1,
   "versionNonce": 190193865,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "M_KV = 2 · L · B · T · H_kv · d_h · S\nGQA attacks H_kv                (fewer distinct heads, Q diversity kept)\nMLA attacks H_kv·d_h → (d_c + d_R)/2   i.e. M = L·B·T·(d_c+d_R)·S\nMLA's K for all heads lies in a shared 512-d subspace (rank ≤ 512),\nbut heads are NOT copies: W^UK_i differ per head",
   "originalText": "M_KV = 2 · L · B · T · H_kv · d_h · S\nGQA attacks H_kv                (fewer distinct heads, Q diversity kept)\nMLA attacks H_kv·d_h → (d_c + d_R)/2   i.e. M = L·B·T·(d_c+d_R)·S\nMLA's K for all heads lies in a shared 512-d subspace (rank ≤ 512),\nbut heads are NOT copies: W^UK_i differ per head",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e352",
   "type": "rectangle",
   "x": 1610.0,
   "y": 3584.0,
   "width": 1450,
   "height": 72.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffec99",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
