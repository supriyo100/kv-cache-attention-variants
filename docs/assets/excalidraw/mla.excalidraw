   "locked": false,
   "text": "MLA: c^KV (512) + k^R (64)\nd_c + d_R = 576\n= 0.28 tile",
   "originalText": "MLA: c^KV (512) + k^R (64)\nd_c + d_R = 576\n= 0.28 tile",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e33",
   "type": "text",
   "x": 1610.0,
   "y": 469.75,
   "width": 738.4,
   "height": 67.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
