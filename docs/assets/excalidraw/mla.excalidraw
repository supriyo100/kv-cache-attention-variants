   "link": null,
   "locked": false
  },
  {
   "id": "e134",
   "type": "text",
   "x": 40,
   "y": 2294.25,
   "width": 929.6500000000001,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 780846360,
   "version": 1,
   "versionNonce": 1317990737,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key insight (absorption): W^UK goes to the query side, W^UV to the output side. At decode, per-head\nK and V are NEVER materialised — every head attends directly over the cached 512-d latents.",
   "originalText": "Key insight (absorption): W^UK goes to the query side, W^UV to the output side. At decode, per-head\nK and V are NEVER materialised — every head attends directly over the cached 512-d latents.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e133",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e135",
   "type": "rectangle",
   "x": 30,
   "y": 2367.75,
   "width": 1450,
   "height": 72.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffc9c9",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 54762750,
   "version": 1,
