   "versionNonce": 1529246226,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "576 / 32,768 = 1.76 %   →  ≈ 57× smaller than MHA\n576 = 2 · 2.25 · 128   →  same cache as GQA with only 2.25 groups\nM_MLA = L · B · T · (d_c + d_R) · S     (no separate V: no factor 2)",
   "originalText": "576 / 32,768 = 1.76 %   →  ≈ 57× smaller than MHA\n576 = 2 · 2.25 · 128   →  same cache as GQA with only 2.25 groups\nM_MLA = L · B · T · (d_c + d_R) · S     (no separate V: no factor 2)",
   "fontSize": 18,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
