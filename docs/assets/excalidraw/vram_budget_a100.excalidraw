   "version": 1,
   "versionNonce": 738749192,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MHA: 14 + 26.2 = 40.2 GB. You are over the GPU before runtime/workspace -> 100K context is impossible.\nGQA-8: 14 + 6.55 = 20.55 GB -> ~19.5 GB left for runtime and extra sequences.\nThis is the real-world value of choosing H_kv.",
   "originalText": "MHA: 14 + 26.2 = 40.2 GB. You are over the GPU before runtime/workspace -> 100K context is impossible.\nGQA-8: 14 + 6.55 = 20.55 GB -> ~19.5 GB left for runtime and extra sequences.\nThis is the real-world value of choosing H_kv.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e198",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e200",
   "type": "rectangle",
   "x": 1250,
