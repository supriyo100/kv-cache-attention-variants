   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "B_max = floor( ( VRAM_usable - W_model - M_overhead ) / KV_per_seq )\nKV_per_seq = 2 * L * T * H_kv * d_h * S   (one sequence)\nVRAM_usable = 40 GB (vLLM: x gpu_memory_utilization)  |  M_overhead ~ 4 GB",
   "originalText": "B_max = floor( ( VRAM_usable - W_model - M_overhead ) / KV_per_seq )\nKV_per_seq = 2 * L * T * H_kv * d_h * S   (one sequence)\nVRAM_usable = 40 GB (vLLM: x gpu_memory_utilization)  |  M_overhead ~ 4 GB",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e225",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
