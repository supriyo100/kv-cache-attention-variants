   "updated": 1,
   "link": null,
   "locked": false,
   "text": "B=1:  6.55 GB   fits\nB=2:  13.1 GB   fits\nB=3:  19.66 GB  fits (max)\nB=4:  26.2 GB   > 22 GB: OOM\nB=8:  52.4 GB   > A100 total",
   "originalText": "B=1:  6.55 GB   fits\nB=2:  13.1 GB   fits\nB=3:  19.66 GB  fits (max)\nB=4:  26.2 GB   > 22 GB: OOM\nB=8:  52.4 GB   > A100 total",
   "fontSize": 16,
