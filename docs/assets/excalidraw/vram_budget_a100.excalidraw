   "locked": false
  },
  {
   "id": "e107",
   "type": "text",
   "x": 253.40000000000003,
   "y": 1520.0,
   "width": 743.1999999999999,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 8790957,
   "version": 1,
   "versionNonce": 312837672,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Config: L=32, H_q=32, d_h=64, FP16 (S=2), T=100K, B=1\nKV/token = 2 * 32 * H_kv * 64 * 2 B  (GQA-8: 2*32*8*64*2 = 65,536 B = 64 KiB)\nKV total = KV/token * 100,000  (GQA-8: 6.55 GB; MHA x4 = 26.2 GB)",
   "originalText": "Config: L=32, H_q=32, d_h=64, FP16 (S=2), T=100K, B=1\nKV/token = 2 * 32 * H_kv * 64 * 2 B  (GQA-8: 2*32*8*64*2 = 65,536 B = 64 KiB)\nKV total = KV/token * 100,000  (GQA-8: 6.55 GB; MHA x4 = 26.2 GB)",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e106",
   "lineHeight": 1.25,
   "autoResize": true
  },
