   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "e201",
   "type": "text",
   "x": 1260,
   "y": 1515.0,
   "width": 666.4,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 182060406,
   "version": 1,
   "versionNonce": 1792394663,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "H_kv is the cheapest architectural lever: KV scales linearly with it.\n32 -> 8 = 4x, 32 -> 1 = 32x. L, T, B, d_h, S are untouched.",
   "originalText": "H_kv is the cheapest architectural lever: KV scales linearly with it.\n32 -> 8 = 4x, 32 -> 1 = 32x. L, T, B, d_h, S are untouched.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e200",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e202",
