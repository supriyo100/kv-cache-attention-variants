   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key insight: 40 GB is physical capacity. It is NOT 40 GB/s of bandwidth\nand NOT TFLOPS. Capacity answers 'can I keep it resident?'",
   "originalText": "Key insight: 40 GB is physical capacity. It is NOT 40 GB/s of bandwidth\nand NOT TFLOPS. Capacity answers 'can I keep it resident?'",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e51",
   "lineHeight": 1.25,
   "autoResize": true
  },
