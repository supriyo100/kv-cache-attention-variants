   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KV is the per-REQUEST cost. Production does not set 'batch = 32'\nand hope: the scheduler tracks real sequence lengths and block\nallocation (PagedAttention) so no request reserves unused KV.",
   "originalText": "KV is the per-REQUEST cost. Production does not set 'batch = 32'\nand hope: the scheduler tracks real sequence lengths and block\nallocation (PagedAttention) so no request reserves unused KV.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e222",
   "lineHeight": 1.25,
   "autoResize": true
  },
