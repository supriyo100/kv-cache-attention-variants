  {
   "id": "e228",
   "type": "text",
   "x": 412.8,
   "y": 2775.0,
   "width": 474.4,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 30586465,
   "version": 1,
   "versionNonce": 1716606102,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Worked (GQA-8, 7B FP16):\nusable KV pool = 40 - 14 - 4 = 22 GB\nKV_per_seq(100K) = 65,536 B/tok * 1e5 = 6.5536 GB\nB_max = floor(22 / 6.5536) = floor(3.36) = 3",
   "originalText": "Worked (GQA-8, 7B FP16):\nusable KV pool = 40 - 14 - 4 = 22 GB\nKV_per_seq(100K) = 65,536 B/tok * 1e5 = 6.5536 GB\nB_max = floor(22 / 6.5536) = floor(3.36) = 3",
   "fontSize": 16,
