   "link": null,
   "locked": false
  },
  {
   "id": "e104",
   "type": "text",
   "x": 10,
   "y": 1325.0,
   "width": 848.8,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1041449536,
   "version": 1,
   "versionNonce": 1784759832,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "70B FP16 cannot sit on one A100-40GB: use tensor parallelism (2 x 80 GB = 160 GB, etc.),\nquantization (INT4 weights: 70e9 x 0.5 B = ~35 GB, still no KV room) or multi-GPU.\nStep 1 of the budget: W_model <= VRAM. If this fails nothing else matters.",
   "originalText": "70B FP16 cannot sit on one A100-40GB: use tensor parallelism (2 x 80 GB = 160 GB, etc.),\nquantization (INT4 weights: 70e9 x 0.5 B = ~35 GB, still no KV room) or multi-GPU.\nStep 1 of the budget: W_model <= VRAM. If this fails nothing else matters.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e103",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e105",
   "type": "text",
   "x": 0,
   "y": 1440,
   "width": 1035.8000000000002,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
