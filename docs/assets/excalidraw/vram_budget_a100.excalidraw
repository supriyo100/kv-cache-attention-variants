   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "3. MHA vs GQA vs MQA at 100K context: the same 14 GB model, stacked",
   "originalText": "3. MHA vs GQA vs MQA at 100K context: the same 14 GB model, stacked",
   "fontSize": 28,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
