   "version": 1,
   "versionNonce": 1307729535,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WRONG:  40 GB - 14 GB weights = 26 GB of KV.\nRIGHT:  40 = Weights + KV + Activations + Workspace + Runtime + Safety margin.\nReserve ~4-6 GB for everything that is not weights or KV.",
   "originalText": "WRONG:  40 GB - 14 GB weights = 26 GB of KV.\nRIGHT:  40 = Weights + KV + Activations + Workspace + Runtime + Safety margin.\nReserve ~4-6 GB for everything that is not weights or KV.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e49",
   "lineHeight": 1.25,
   "autoResize": true
  },
