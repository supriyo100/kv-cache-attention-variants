  {
   "id": "e362",
   "type": "text",
   "x": 2410,
   "y": 1661.0,
   "width": 718.0,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
