   "seed": 277508149,
   "version": 1,
   "versionNonce": 92783518,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "You do not need 100% full attention: maybe 25% of layers can provide the expensive\nhigh-fidelity retrieval and 75% can use state-based processing (Qwen3-Next 3:1; Jamba\n1:7 uses 12.5%).",
   "originalText": "You do not need 100% full attention: maybe 25% of layers can provide the expensive\nhigh-fidelity retrieval and 75% can use state-based processing (Qwen3-Next 3:1; Jamba\n1:7 uses 12.5%).",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e361",
   "lineHeight": 1.25,
   "autoResize": true
  },
