   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Capacity = cheap memory + selective exact retrieval",
   "originalText": "Capacity = cheap memory + selective exact retrieval",
   "fontSize": 18,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "e359",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
