    },
    {
      "id": "e229",
      "type": "text",
      "x": 40,
      "y": 2975.25,
      "width": 836.1500000000001,
      "height": 63.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2084970774,
      "version": 2,
      "versionNonce": 973755791,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791132667507,
      "link": null,
      "locked": false,
      "text": "Key insight: wavelengths form a geometric series from 6.3 tokens to 54K (or 2.6M) tokens.\nRaising the base (Llama-3: 500000) slows the slow pairs → more pairs can still tell far\npositions apart at long context.",
      "originalText": "Key insight: wavelengths form a geometric series from 6.3 tokens to 54K (or 2.6M) tokens.\nRaising the base (Llama-3: 500000) slows the slow pairs → more pairs can still tell far\npositions apart at long context.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e228",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b2h"
    },
