    {
      "id": "e46",
      "type": "text",
      "x": 284,
      "y": 989,
      "width": 432.4,
      "height": 85,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
