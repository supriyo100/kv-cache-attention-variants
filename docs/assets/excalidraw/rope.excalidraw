      "boundElements": [],
      "updated": 1791132667502,
      "link": null,
      "locked": false,
      "text": "Key insight: rotation is orthogonal → it never changes |q| or |k|, only their angle. Position\ninformation lives purely in angles, so content magnitude (what the token 'is') is untouched.",
      "originalText": "Key insight: rotation is orthogonal → it never changes |q| or |k|, only their angle. Position\ninformation lives purely in angles, so content magnitude (what the token 'is') is untouched.",
