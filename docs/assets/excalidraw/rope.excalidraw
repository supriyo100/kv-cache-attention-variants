        }
      ],
      "updated": 1791132667504,
      "link": null,
      "locked": false,
      "index": "b0H"
    },
    {
      "id": "e79",
      "type": "text",
      "x": 1620,
      "y": 1385,
      "width": 939.0000000000001,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 48453508,
      "version": 2,
      "versionNonce": 1498811457,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791132667504,
      "link": null,
      "locked": false,
      "text": "Long-term decay (RoFormer §3.4.3): |Σ_i q_i conj(k_i) e^{j(m−n)θ_i}| tends to shrink as |m−n| grows,\nbecause the 64 phasors spin at different speeds and stop adding coherently.",
      "originalText": "Long-term decay (RoFormer §3.4.3): |Σ_i q_i conj(k_i) e^{j(m−n)θ_i}| tends to shrink as |m−n| grows,\nbecause the 64 phasors spin at different speeds and stop adding coherently.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e78",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0I"
    },
    {
      "id": "e101",
      "type": "rectangle",
      "x": 0,
      "y": 1701,
      "width": 3100,
      "height": 533.25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
