    },
    {
      "id": "e77",
      "type": "text",
      "x": 1620,
      "y": 1296.5,
      "width": 920.3000000000001,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 828480808,
      "version": 2,
      "versionNonce": 619364449,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791132667504,
      "link": null,
      "locked": false,
      "text": "Key insight: e^{jmθ}·conj(e^{jnθ}) = e^{j(m−n)θ}. Phases multiply, so the absolute phases cancel —\nthis one line IS the relative-position property.",
      "originalText": "Key insight: e^{jmθ}·conj(e^{jnθ}) = e^{j(m−n)θ}. Phases multiply, so the absolute phases cancel —\nthis one line IS the relative-position property.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e76",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0G"
    },
    {
      "id": "e78",
      "type": "rectangle",
      "x": 1610,
      "y": 1370,
      "width": 1450,
      "height": 72.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1435920784,
      "version": 2,
      "versionNonce": 73970223,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
