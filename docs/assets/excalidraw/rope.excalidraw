      "seed": 1233565528,
      "version": 2,
      "versionNonce": 1982603873,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791132667503,
      "link": null,
      "locked": false,
      "text": "R_m = diag( R(mθ₀), R(mθ₁), …, R(mθ₆₃) )\n        128 × 128, mostly zeros\n→ never materialised; applied element-wise\n   (cost O(d_h) per vector, not O(d_h²))",
      "originalText": "R_m = diag( R(mθ₀), R(mθ₁), …, R(mθ₆₃) )\n        128 × 128, mostly zeros\n→ never materialised; applied element-wise\n   (cost O(d_h) per vector, not O(d_h²))",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ak"
    },
    {
      "id": "e47",
      "type": "text",
      "x": 30,
      "y": 1257,
      "width": 595.6,
      "height": 63.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1127850897,
      "version": 2,
      "versionNonce": 1810264111,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791132667503,
      "link": null,
      "locked": false,
      "text": "θ_i = base^(−2i/d_h),  i = 0 … d_h/2 − 1 = 0 … 63\nθ₀  = 1 rad/token          (fast: turns every ~6.3 tokens)\nθ₆₃ = 10000^(−126/128) = 1.155e−4 rad/token   (very slow)",
      "originalText": "θ_i = base^(−2i/d_h),  i = 0 … d_h/2 − 1 = 0 … 63\nθ₀  = 1 rad/token          (fast: turns every ~6.3 tokens)\nθ₆₃ = 10000^(−126/128) = 1.155e−4 rad/token   (very slow)",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
