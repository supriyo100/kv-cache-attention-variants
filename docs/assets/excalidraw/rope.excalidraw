      "isDeleted": false,
      "boundElements": [],
      "updated": 1791132667502,
      "link": null,
      "locked": false,
      "text": "blue = (x_2i, x_2i+1) before\nred = after rotating by m·θ_i\n|vector| unchanged",
      "originalText": "blue = (x_2i, x_2i+1) before\nred = after rotating by m·θ_i\n|vector| unchanged",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aL"
    },
    {
      "id": "e21",
      "type": "text",
      "x": 2040,
      "y": 272,
      "width": 786.1,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2096491879,
      "version": 2,
      "versionNonce": 1844431841,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791132667502,
      "link": null,
      "locked": false,
      "text": "Each consecutive PAIR of a q/k vector is a 2-D point; rotate it by angle m·θ_i:",
      "originalText": "Each consecutive PAIR of a q/k vector is a 2-D point; rotate it by angle m·θ_i:",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aM"
    },
    {
      "id": "e22",
      "type": "text",
      "x": 2040,
      "y": 304.5,
      "width": 562.6,
      "height": 71.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 100035545,
      "version": 2,
      "versionNonce": 44834479,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791132667502,
      "link": null,
      "locked": false,
      "text": "┌ x'_2i   ┐   ┌ cos mθ_i   −sin mθ_i ┐ ┌ x_2i   ┐\n│         │ = │                      │ │        │\n└ x'_2i+1 ┘   └ sin mθ_i    cos mθ_i ┘ └ x_2i+1 ┘",
      "originalText": "┌ x'_2i   ┐   ┌ cos mθ_i   −sin mθ_i ┐ ┌ x_2i   ┐\n│         │ = │                      │ │        │\n└ x'_2i+1 ┘   └ sin mθ_i    cos mθ_i ┘ └ x_2i+1 ┘",
      "fontSize": 19,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aN"
    },
    {
      "id": "e23",
      "type": "text",
      "x": 2040,
      "y": 385.75,
      "width": 473.2,
      "height": 63.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1843546982,
      "version": 2,
      "versionNonce": 1689102273,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791132667502,
      "link": null,
      "locked": false,
      "text": "m   = token position (0, 1, 2, …)\nθ_i = base^(−2i/d_h)   (rad per token, pair i)\nR(α)ᵀ = R(−α),  R(α)R(β) = R(α+β),  det = 1",
      "originalText": "m   = token position (0, 1, 2, …)\nθ_i = base^(−2i/d_h)   (rad per token, pair i)\nR(α)ᵀ = R(−α),  R(α)R(β) = R(α+β),  det = 1",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aO"
    },
