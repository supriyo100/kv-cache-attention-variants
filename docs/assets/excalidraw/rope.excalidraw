    {
      "id": "e227",
      "type": "text",
      "x": 2080,
      "y": 2658.75,
      "width": 544.6,
      "height": 85,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 281285696,
      "version": 2,
      "versionNonce": 953260911,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791132667507,
      "link": null,
      "locked": false,
      "text": "λ₀  = 2π ≈ 6.3 tokens          (fastest pair)\nλ₆₃ ≈ 54,400 tokens  @ base 10000\nλ₆₃ ≈ 2.56 M tokens  @ base 500000\npairs with λ_i > 8192: i ≥ 50 (b=1e4), i ≥ 35 (b=5e5)",
      "originalText": "λ₀  = 2π ≈ 6.3 tokens          (fastest pair)\nλ₆₃ ≈ 54,400 tokens  @ base 10000\nλ₆₃ ≈ 2.56 M tokens  @ base 500000\npairs with λ_i > 8192: i ≥ 50 (b=1e4), i ≥ 35 (b=5e5)",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b2f"
    },
    {
      "id": "e228",
