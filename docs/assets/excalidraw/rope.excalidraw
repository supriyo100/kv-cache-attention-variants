      "boundElements": [],
      "updated": 1791132667502,
      "link": null,
      "locked": false,
      "text": "R(30°)·(1, 0) = (cos30°, sin30°) = (0.866, 0.5)\n|(0.866, 0.5)| = √(0.75 + 0.25) = 1   ✓ norm kept",
      "originalText": "R(30°)·(1, 0) = (cos30°, sin30°) = (0.866, 0.5)\n|(0.866, 0.5)| = √(0.75 + 0.25) = 1   ✓ norm kept",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
