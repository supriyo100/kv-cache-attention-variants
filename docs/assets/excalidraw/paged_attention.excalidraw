   "versionNonce": 677748798,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Beam search: beams share a long prefix; when a beam is pruned its blocks get\nref-1 and return to the pool at 0. Paper (Alpaca): memory saved 6.1-9.8% for\nparallel sampling, 37.6-55.2% for beam search.",
   "originalText": "Beam search: beams share a long prefix; when a beam is pruned its blocks get\nref-1 and return to the pool at 0. Paper (Alpaca): memory saved 6.1-9.8% for\nparallel sampling, 37.6-55.2% for beam search.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e570",
   "lineHeight": 1.25,
   "autoResize": true
  },
