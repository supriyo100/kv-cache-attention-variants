  {
   "id": "e290",
   "type": "text",
   "x": 10,
   "y": 1865.0,
   "width": 1095.3999999999999,
   "height": 127.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
