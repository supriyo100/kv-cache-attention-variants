   "roundness": null,
   "seed": 535420749,
   "version": 1,
   "versionNonce": 2085289515,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "n=4 samples, 2,000-token prompt, 100 generated each (128 KiB/token):\nnaive copies : 4 x 2,100 = 8,400 token-states = 1,050 MiB\nshared + CoW : 2,000 + 4 x 100 = 2,400 token-states = 300 MiB  (3.5x less)\n(ignoring the one partly filled block per sample that CoW duplicates)",
   "originalText": "n=4 samples, 2,000-token prompt, 100 generated each (128 KiB/token):\nnaive copies : 4 x 2,100 = 8,400 token-states = 1,050 MiB\nshared + CoW : 2,000 + 4 x 100 = 2,400 token-states = 300 MiB  (3.5x less)\n(ignoring the one partly filled block per sample that CoW duplicates)",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e568",
   "lineHeight": 1.25,
   "autoResize": true
  },
