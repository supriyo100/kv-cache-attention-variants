   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Same attention math; only the address calculation changed. Per-block online softmax\n(FlashAttention style) means blocks need no gather-copy into a contiguous buffer.",
   "originalText": "Same attention math; only the address calculation changed. Per-block online softmax\n(FlashAttention style) means blocks need no gather-copy into a contiguous buffer.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e443",
   "lineHeight": 1.25,
   "autoResize": true
  },
