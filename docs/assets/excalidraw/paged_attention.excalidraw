   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A new request hashes its full 16-token blocks in order; each hit reuses the block (ref += 1), the first miss starts fresh compute.",
   "originalText": "A new request hashes its full 16-token blocks in order; each hit reuses the block (ref += 1), the first miss starts fresh compute.",
