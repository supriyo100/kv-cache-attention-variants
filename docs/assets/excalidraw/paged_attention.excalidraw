   "y": 521.0,
   "width": 1023.7,
   "height": 67.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 54762750,
   "version": 1,
   "versionNonce": 151001551,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Internal fragmentation: slab sized for max_len, real output length unknown -> tail of every slab wasted\nExternal fragmentation: free holes (5 + 3 cells) are not contiguous -> E (needs 6) cannot be placed\nOver-reservation: a chat that stops after 40 tokens still pins a whole max_len slab",
   "originalText": "Internal fragmentation: slab sized for max_len, real output length unknown -> tail of every slab wasted\nExternal fragmentation: free holes (5 + 3 cells) are not contiguous -> E (needs 6) cannot be placed\nOver-reservation: a chat that stops after 40 tokens still pins a whole max_len slab",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e134",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e136",
   "type": "text",
   "x": 0,
   "y": 640,
   "width": 1063.3000000000002,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1877614492,
   "version": 1,
   "versionNonce": 446574991,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Slab of max_len = 8192 tokens on Llama-3-8B (128 KiB/token) = 1 GiB per request, whether or not it is used.",
   "originalText": "Slab of max_len = 8192 tokens on Llama-3-8B (128 KiB/token) = 1 GiB per request, whether or not it is used.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
