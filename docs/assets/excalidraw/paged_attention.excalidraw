   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Decode is memory-bound: every K/V byte is read once. Paging adds index loads, not FLOPs,\nbut the kernel must be written for non-contiguous access.",
   "originalText": "Decode is memory-bound: every K/V byte is read once. Paging adds index loads, not FLOPs,\nbut the kernel must be written for non-contiguous access.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e445",
   "lineHeight": 1.25,
   "autoResize": true
  },
