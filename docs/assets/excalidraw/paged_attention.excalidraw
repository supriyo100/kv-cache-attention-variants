   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "for j in range(ceil(T / 16)):\n    p = block_table[seq][j]             # logical -> physical\n    K, V = k_cache[p], v_cache[p]       # [16, H_kv, d_h]\n    mask last block to T - 16*j valid slots",
   "originalText": "for j in range(ceil(T / 16)):\n    p = block_table[seq][j]             # logical -> physical\n    K, V = k_cache[p], v_cache[p]       # [16, H_kv, d_h]\n    mask last block to T - 16*j valid slots",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e441",
   "lineHeight": 1.25,
   "autoResize": true
  },
