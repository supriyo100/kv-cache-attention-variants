   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Pool size = KV budget / block bytes. Example: ~18 GB (~16.8 GiB) KV / 2 MiB = ~8,580 blocks\n= ~137K tokens = ~16 sequences of 8K. Admission control is just counting free blocks.",
   "originalText": "Pool size = KV budget / block bytes. Example: ~18 GB (~16.8 GiB) KV / 2 MiB = ~8,580 blocks\n= ~137K tokens = ~16 sequences of 8K. Admission control is just counting free blocks.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e407",
   "lineHeight": 1.25,
   "autoResize": true
  },
