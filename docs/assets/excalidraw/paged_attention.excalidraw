  {
   "id": "e569",
   "type": "text",
   "x": 10,
   "y": 3394.5,
   "width": 758.8,
   "height": 85.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
