  {
   "id": "e442",
   "type": "text",
   "x": 1710,
   "y": 2305.0,
   "width": 589.6,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
