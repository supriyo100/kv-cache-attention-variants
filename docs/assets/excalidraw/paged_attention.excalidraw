   "roundness": null,
   "seed": 2025650538,
   "version": 1,
   "versionNonce": 435055552,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KV per token, all layers : 2*L*H_kv*d_h*S = 2*32*8*128*2 = 131,072 B = 128 KiB\none block (16 tokens)    : 16 x 128 KiB = 2 MiB   (K and V, all 32 layers)\nper layer per block      : K[16,8,128] BF16 = 16*8*128*2 B = 32 KiB ; V same -> 64 KiB ; x32 layers = 2 MiB\nmax waste per sequence   : (block_size - 1) tokens = 15 x 128 KiB = 1.875 MiB\nchat of 500 tokens       : reserve 8192 x 128 KiB = 1 GiB, use 500 x 128 KiB = 62.5 MiB -> 93.9% idle\npaged                    : ceil(500/16) = 32 blocks = 64 MiB -> waste 12 tokens = 1.5 MiB",
   "originalText": "KV per token, all layers : 2*L*H_kv*d_h*S = 2*32*8*128*2 = 131,072 B = 128 KiB\none block (16 tokens)    : 16 x 128 KiB = 2 MiB   (K and V, all 32 layers)\nper layer per block      : K[16,8,128] BF16 = 16*8*128*2 B = 32 KiB ; V same -> 64 KiB ; x32 layers = 2 MiB\nmax waste per sequence   : (block_size - 1) tokens = 15 x 128 KiB = 1.875 MiB\nchat of 500 tokens       : reserve 8192 x 128 KiB = 1 GiB, use 500 x 128 KiB = 62.5 MiB -> 93.9% idle\npaged                    : ceil(500/16) = 32 blocks = 64 MiB -> waste 12 tokens = 1.5 MiB",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e289",
   "lineHeight": 1.25,
   "autoResize": true
  },
