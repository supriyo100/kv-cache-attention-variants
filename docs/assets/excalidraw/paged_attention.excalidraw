   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "logical block  j = p // 16   = 37 // 16 = 2\noffset in blk  o = p %  16   = 37 %  16 = 5\nphysical slot    = block_table[j] * 16 + o = 3 * 16 + 5 = 53",
   "originalText": "logical block  j = p // 16   = 37 // 16 = 2\noffset in blk  o = p %  16   = 37 %  16 = 5\nphysical slot    = block_table[j] * 16 + o = 3 * 16 + 5 = 53",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
