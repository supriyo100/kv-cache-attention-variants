   "version": 1,
   "versionNonce": 772092315,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "M_KV = 2 × L × H_kv × d_h × bytes × T × B\n     = 2 × 32 × 8 × 64 × 2 × 100,000 × 1\n     = 6,553,600,000 bytes",
   "originalText": "M_KV = 2 × L × H_kv × d_h × bytes × T × B\n     = 2 × 32 × 8 × 64 × 2 × 100,000 × 1\n     = 6,553,600,000 bytes",
   "fontSize": 20,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e23",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e25",
   "type": "rectangle",
   "x": 1250,
   "y": 240,
   "width": 680,
   "height": 330,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffc9c9",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1048386556,
   "version": 1,
   "versionNonce": 351564608,
   "isDeleted": false,
   "boundElements": [
