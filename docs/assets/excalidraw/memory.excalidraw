   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Layers        L     = 32\nQuery heads   H_q   = 32\nKV heads      H_kv  = 8\n  → 32/8 = 4 Q heads per KV head\nHead dim      d_h   = 64\nd_model = H_q·d_h  = 2048\nFP16 / BF16         = 2 B\nSeq length    T     = 100,000\nBatch         B     = 1",
   "originalText": "Layers        L     = 32\nQuery heads   H_q   = 32\nKV heads      H_kv  = 8\n  → 32/8 = 4 Q heads per KV head\nHead dim      d_h   = 64\nd_model = H_q·d_h  = 2048\nFP16 / BF16         = 2 B\nSeq length    T     = 100,000\nBatch         B     = 1",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e4",
   "lineHeight": 1.25,
   "autoResize": true
