   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "M_KV,max ≈ M_GPU − weights − activations/workspace − runtime\n         = 32 − 20 − 2 − 2 = 8 GB\n8 GB ÷ 64 KiB/token ≈ 122,070 tokens TOTAL, shared by the whole batch\n→ 1 request at 100K   or   14 requests at 8K\nAt long context × high concurrency, KV — not weights — caps how many users fit.",
   "originalText": "M_KV,max ≈ M_GPU − weights − activations/workspace − runtime\n         = 32 − 20 − 2 − 2 = 8 GB\n8 GB ÷ 64 KiB/token ≈ 122,070 tokens TOTAL, shared by the whole batch\n→ 1 request at 100K   or   14 requests at 8K\nAt long context × high concurrency, KV — not weights — caps how many users fit.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e61",
   "lineHeight": 1.25,
   "autoResize": true
