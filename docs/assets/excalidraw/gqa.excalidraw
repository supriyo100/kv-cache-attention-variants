   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM / TRADE-OFF\ng must divide H_q.\nHeads in a group are\nforced to share one\nkey/value subspace.",
   "originalText": "PROBLEM / TRADE-OFF\ng must divide H_q.\nHeads in a group are\nforced to share one\nkey/value subspace.",
