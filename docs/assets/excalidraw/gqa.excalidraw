   "version": 1,
   "versionNonce": 283342002,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Key insight: GQA only shrinks H_kv. The other terms of M_KV = 2·L·B·T·H_kv·d_h·S are still free to attack, so GQA stacks with cross-layer sharing (L),\nKV quantisation (S), eviction (T) and paging. TransMLA instead replaces the head-sharing scheme itself with a compressed latent.",
   "originalText": "Key insight: GQA only shrinks H_kv. The other terms of M_KV = 2·L·B·T·H_kv·d_h·S are still free to attack, so GQA stacks with cross-layer sharing (L),\nKV quantisation (S), eviction (T) and paging. TransMLA instead replaces the head-sharing scheme itself with a compressed latent.",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "t3_21",
   "lineHeight": 1.25,
   "autoResize": true
  }
