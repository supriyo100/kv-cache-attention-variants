   "updated": 1,
   "link": null,
   "locked": false,
   "text": "per token (all layers) = 2 . L . H_kv . d_h . S      M_GQA = M_MHA . (H_kv / H_q) = M_MHA / g",
   "originalText": "per token (all layers) = 2 . L . H_kv . d_h . S      M_GQA = M_MHA . (H_kv / H_q) = M_MHA / g",
