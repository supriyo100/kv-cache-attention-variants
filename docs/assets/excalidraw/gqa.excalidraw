   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KV-read time lower bound @ 1.555 TB/s (toy, T=100K, B=1)\n  MHA 26.2 GB -> 16.8 ms   GQA-16 13.1 GB -> 8.4 ms\n  GQA-8 6.55 GB -> 4.2 ms   GQA-4 3.28 GB -> 2.1 ms   MQA 0.82 GB -> 0.53 ms",
   "originalText": "KV-read time lower bound @ 1.555 TB/s (toy, T=100K, B=1)\n  MHA 26.2 GB -> 16.8 ms   GQA-16 13.1 GB -> 8.4 ms\n  GQA-8 6.55 GB -> 4.2 ms   GQA-4 3.28 GB -> 2.1 ms   MQA 0.82 GB -> 0.53 ms",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e420",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e422",
