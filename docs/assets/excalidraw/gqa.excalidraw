  {
   "id": "e379",
   "type": "text",
   "x": 10,
   "y": 2552.5,
   "width": 820.0,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1574278140,
   "version": 1,
   "versionNonce": 1085883652,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "def repeat_kv(k, g):              # k: (B, T, H_kv, d_h)\n    B, T, Hkv, d = k.shape\n    k = k[:, :, :, None, :]                  # (B, T, Hkv, 1, d)\n    k = k.expand(B, T, Hkv, g, d)            # (B, T, Hkv, g, d)  view, stride 0\n    return k.reshape(B, T, Hkv * g, d)       # (B, T, H_q, d)  <- materialises a copy",
   "originalText": "def repeat_kv(k, g):              # k: (B, T, H_kv, d_h)\n    B, T, Hkv, d = k.shape\n    k = k[:, :, :, None, :]                  # (B, T, Hkv, 1, d)\n    k = k.expand(B, T, Hkv, g, d)            # (B, T, Hkv, g, d)  view, stride 0\n    return k.reshape(B, T, Hkv * g, d)       # (B, T, H_q, d)  <- materialises a copy",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e378",
   "lineHeight": 1.25,
   "autoResize": true
  },
