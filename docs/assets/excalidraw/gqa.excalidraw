  {
   "id": "e382",
   "type": "text",
   "x": 1960,
   "y": 2277.5,
   "width": 781.6,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
