   "locked": false
  },
  {
   "id": "e558",
   "type": "text",
   "x": 2070,
   "y": 4802.0,
   "width": 568.3000000000001,
   "height": 180.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 843744994,
   "version": 1,
   "versionNonce": 837864501,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY INSIGHT\nHow to pick g\n- KV capacity bound (long ctx, many users): smaller H_kv\n- TPOT bound (decode is KV-bandwidth bound): smaller H_kv\n- quality critical: g = 4..8 (H_kv 8) is the usual answer\n- tensor parallel degree P: want H_kv multiple of P\n  (8 KV heads = one per GPU on an 8-GPU node)\n- have an MHA checkpoint: uptrain, do not retrain",
   "originalText": "KEY INSIGHT\nHow to pick g\n- KV capacity bound (long ctx, many users): smaller H_kv\n- TPOT bound (decode is KV-bandwidth bound): smaller H_kv\n- quality critical: g = 4..8 (H_kv 8) is the usual answer\n- tensor parallel degree P: want H_kv multiple of P\n  (8 KV heads = one per GPU on an 8-GPU node)\n- have an MHA checkpoint: uptrain, do not retrain",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e557",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e559",
   "type": "rectangle",
   "x": 2060,
   "y": 5013.0,
   "width": 479.50000000000006,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffc9c9",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 2144890576,
   "version": 1,
   "versionNonce": 1868250484,
   "isDeleted": false,
   "boundElements": [
