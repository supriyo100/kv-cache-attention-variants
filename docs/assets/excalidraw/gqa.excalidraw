   "locked": false
  },
  {
   "id": "e423",
   "type": "text",
   "x": 2410,
   "y": 2926.5,
   "width": 489.1,
   "height": 135.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2295477,
   "version": 1,
   "versionNonce": 720121671,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY INSIGHT\nGQA is NOT only a VRAM saving: it cuts the bytes\nmoved per token by g, raising AI by g.\ng = 4 still leaves AI = 4, ~50x below the A100\nridge (200): decode attention stays memory-bound.\nFaster decode = fewer bytes, not more FLOPS.",
   "originalText": "KEY INSIGHT\nGQA is NOT only a VRAM saving: it cuts the bytes\nmoved per token by g, raising AI by g.\ng = 4 still leaves AI = 4, ~50x below the A100\nridge (200): decode attention stays memory-bound.\nFaster decode = fewer bytes, not more FLOPS.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e422",
   "lineHeight": 1.25,
   "autoResize": true
  },
