   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY INSIGHT\nSame GPU, same weights: H_kv 32 -> 8 turns 'impossible' (40.2 GB) into 20.55 GB with room to batch.\nProduction schedulers must budget real sequence lengths, not 'batch = 32 and hope'.",
   "originalText": "KEY INSIGHT\nSame GPU, same weights: H_kv 32 -> 8 turns 'impossible' (40.2 GB) into 20.55 GB with room to batch.\nProduction schedulers must budget real sequence lengths, not 'batch = 32 and hope'.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e478",
   "lineHeight": 1.25,
   "autoResize": true
  },
