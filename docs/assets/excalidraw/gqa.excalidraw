  {
   "id": "e384",
   "type": "text",
   "x": 1960,
   "y": 2407.5,
   "width": 617.8000000000001,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 228237454,
   "version": 1,
   "versionNonce": 1413732114,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY INSIGHT\nEach KV head is streamed from HBM ONCE and multiplied by g = 4\nquery rows: (4,128)@(128,T) = GEMM, not 4 GEMVs.\nThis is exactly why AI rises from 1 (MHA) to g.",
   "originalText": "KEY INSIGHT\nEach KV head is streamed from HBM ONCE and multiplied by g = 4\nquery rows: (4,128)@(128,T) = GEMM, not 4 GEMVs.\nThis is exactly why AI rises from 1 (MHA) to g.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e383",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e385",
   "type": "rectangle",
   "x": 0,
   "y": 2687.5,
   "width": 1172.5,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "#ffc9c9",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1758617616,
   "version": 1,
   "versionNonce": 1396091995,
   "isDeleted": false,
   "boundElements": [
