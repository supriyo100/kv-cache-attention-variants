   "updated": 1,
   "link": null,
   "locked": false,
   "text": "M_KV = 2 . L . B . T . H_kv . d_h . S      GQA: 1 < H_kv < H_q,  group size g = H_q / H_kv   (Ainslie et al. 2023, arXiv 2305.13245)",
   "originalText": "M_KV = 2 . L . B . T . H_kv . d_h . S      GQA: 1 < H_kv < H_q,  group size g = H_q / H_kv   (Ainslie et al. 2023, arXiv 2305.13245)",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
