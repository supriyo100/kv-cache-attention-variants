   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY INSIGHT\nGQA is one dial.  H_kv = H_q gives MHA, H_kv = 1 gives MQA.\nEach halving of H_kv halves the cache (and the bytes read per token).",
   "originalText": "KEY INSIGHT\nGQA is one dial.  H_kv = H_q gives MHA, H_kv = 1 gives MQA.\nEach halving of H_kv halves the cache (and the bytes read per token).",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e127",
   "lineHeight": 1.25,
   "autoResize": true
  },
