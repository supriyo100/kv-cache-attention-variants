   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "e386",
   "type": "text",
   "x": 10,
   "y": 2702.5,
   "width": 1142.5,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 928094289,
   "version": 1,
   "versionNonce": 1409843281,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM / TRADE-OFF\nNaive repeat_kv writes H_q x T x d_h x 2 B per layer per step for K, and the same again for V (2 x 32x128xT x 2 B),\nre-inflating the cache to MHA size in HBM traffic. Fused kernels\n(FlashAttention, vLLM paged-attn) index kv = h // g instead of copying.",
   "originalText": "PROBLEM / TRADE-OFF\nNaive repeat_kv writes H_q x T x d_h x 2 B per layer per step for K, and the same again for V (2 x 32x128xT x 2 B),\nre-inflating the cache to MHA size in HBM traffic. Fused kernels\n(FlashAttention, vLLM paged-attn) index kv = h // g instead of copying.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e385",
   "lineHeight": 1.25,
   "autoResize": true
  },
