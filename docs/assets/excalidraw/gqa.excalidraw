   "link": null,
   "locked": false
  },
  {
   "id": "e265",
   "type": "text",
   "x": 710,
   "y": 1322.0,
   "width": 667.3000000000001,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1192802337,
   "version": 1,
   "versionNonce": 1036132969,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY INSIGHT\nWithin a group: Q_1 != Q_2 != Q_3 != Q_4 but K_1 = K_2 = K_3 = K_4.\nQuery-side diversity is kept; K/V diversity is reduced only 4x\n(8 distinct K/V views instead of 1 in MQA, 32 in MHA).",
   "originalText": "KEY INSIGHT\nWithin a group: Q_1 != Q_2 != Q_3 != Q_4 but K_1 = K_2 = K_3 = K_4.\nQuery-side diversity is kept; K/V diversity is reduced only 4x\n(8 distinct K/V views instead of 1 in MQA, 32 in MHA).",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e264",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e266",
