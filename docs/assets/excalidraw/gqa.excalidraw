   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "K_g = (1/n) sum_{i in g} K_i    V_g = (1/n) sum_{i in g} V_i    n = g = 4\nW_k' = W_k.view(4096,8,4,128).mean(dim=2).reshape(4096,1024)\n(same for W_v); W_q, W_o, FFN, embeddings copied unchanged",
   "originalText": "K_g = (1/n) sum_{i in g} K_i    V_g = (1/n) sum_{i in g} V_i    n = g = 4\nW_k' = W_k.view(4096,8,4,128).mean(dim=2).reshape(4096,1024)\n(same for W_v); W_q, W_o, FFN, embeddings copied unchanged",
   "fontSize": 16,
   "fontFamily": 3,
