   "updated": 1,
   "link": null,
   "locked": false,
   "text": "free for KV = 40 - 14 (weights) - ~4 (runtime) = ~22 GB\nmax sequences @100K:  MHA 0   GQA-16 1   GQA-8 3   GQA-4 6   MQA ~26",
   "originalText": "free for KV = 40 - 14 (weights) - ~4 (runtime) = ~22 GB\nmax sequences @100K:  MHA 0   GQA-16 1   GQA-8 3   GQA-4 6   MQA ~26",
