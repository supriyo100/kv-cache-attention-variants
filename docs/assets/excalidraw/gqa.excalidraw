    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "e560",
   "type": "text",
   "x": 2070,
   "y": 5028.0,
   "width": 449.50000000000006,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1265247240,
   "version": 1,
   "versionNonce": 164069245,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM / TRADE-OFF\nH_kv < P forces K/V replication across GPUs\n(MQA: 1 head copied on every GPU), so per-GPU\nKV stops shrinking.",
   "originalText": "PROBLEM / TRADE-OFF\nH_kv < P forces K/V replication across GPUs\n(MQA: 1 head copied on every GPU), so per-GPU\nKV stops shrinking.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e559",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
