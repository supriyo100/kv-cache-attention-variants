   "seed": 1019540713,
   "version": 1,
   "versionNonce": 527592750,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "q = q.view(B, Hkv, g, d)                   # (B, 8, 4, 128)  g rows per KV head\nS = q @ K.transpose(-1,-2) / d**0.5       # (B,8,4,128)@(B,8,128,T) = (B,8,4,T)\no = S.softmax(-1) @ V                     # (B,8,4,T)@(B,8,T,128)   = (B,8,4,128)\no = o.reshape(B, 1, Hq * d)               # (B, 1, 4096)",
   "originalText": "q = q.view(B, Hkv, g, d)                   # (B, 8, 4, 128)  g rows per KV head\nS = q @ K.transpose(-1,-2) / d**0.5       # (B,8,4,128)@(B,8,128,T) = (B,8,4,T)\no = S.softmax(-1) @ V                     # (B,8,4,T)@(B,8,T,128)   = (B,8,4,128)\no = o.reshape(B, 1, Hq * d)               # (B, 1, 4096)",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e381",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "e383",
