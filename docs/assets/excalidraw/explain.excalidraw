   "seed": 395970335,
   "version": 1,
   "versionNonce": 1571754094,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "GPU memory ≈ weights + KV cache + activations/workspace + runtime overhead\n→ at long context / high concurrency the KV cache, not the weights, caps how many users fit.\nNote: session06 passes MLA through the ×2 (K+V) formula — MLA caches ONE latent, so true size is half.",
   "originalText": "GPU memory ≈ weights + KV cache + activations/workspace + runtime overhead\n→ at long context / high concurrency the KV cache, not the weights, caps how many users fit.\nNote: session06 passes MLA through the ×2 (K+V) formula — MLA caches ONE latent, so true size is half.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
