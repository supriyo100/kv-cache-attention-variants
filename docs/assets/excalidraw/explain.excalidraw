  {
   "id": "el36",
   "type": "text",
   "x": 40,
   "y": 600,
   "width": 1012.0000000000001,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
