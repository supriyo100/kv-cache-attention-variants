   "seed": 295334610,
   "version": 1,
   "versionNonce": 401991736,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "• Prefill: whole prompt in ONE parallel pass (compute-bound, sets TTFT)\n• Decode: strictly sequential, 1 token per step (memory-bandwidth-bound, ~20–30 ms/token)\n• Left-pad batches for generation so position -1 is a real token; mask PADs; position_ids = cumsum-1\n• Special tokens: <BOS> start/attention sink, <EOS> stop, <PAD> masked, chat-template role tokens",
   "originalText": "• Prefill: whole prompt in ONE parallel pass (compute-bound, sets TTFT)\n• Decode: strictly sequential, 1 token per step (memory-bandwidth-bound, ~20–30 ms/token)\n• Left-pad batches for generation so position -1 is a real token; mask PADs; position_ids = cumsum-1\n• Special tokens: <BOS> start/attention sink, <EOS> stop, <PAD> masked, chat-template role tokens",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
