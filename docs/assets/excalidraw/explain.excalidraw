  {
   "id": "el163",
   "type": "text",
   "x": 40,
   "y": 1500,
   "width": 1032.16,
   "height": 67.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
