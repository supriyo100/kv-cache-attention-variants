    {
      "id": "t2_124",
      "type": "text",
      "x": 1765.2,
      "y": 4348.75,
      "width": 285.59999999999997,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
