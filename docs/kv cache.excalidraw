      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 746475669,
      "version": 1,
      "versionNonce": 129702192,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "After prefill, the last prompt\ntokens (observation window) vote\nwhich earlier tokens each head\nkeeps; the rest are dropped.\n32k prompt → 2k kept: 16× less.\nPyramidKV: larger budgets in\nlower layers, smaller higher up.\n\nGood for long RAG prompts with a\nknown question; risky for\nmulti-turn follow-ups.",
      "originalText": "After prefill, the last prompt\ntokens (observation window) vote\nwhich earlier tokens each head\nkeeps; the rest are dropped.\n32k prompt → 2k kept: 16× less.\nPyramidKV: larger budgets in\nlower layers, smaller higher up.\n\nGood for long RAG prompts with a\nknown question; risky for\nmulti-turn follow-ups.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
