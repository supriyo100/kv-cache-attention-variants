      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "5 local (W 1024) : 1 global\n~6.3k token-eq · ~5× less",
      "originalText": "5 local (W 1024) : 1 global\n~6.3k token-eq · ~5× less",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_58",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_60",
      "type": "text",
      "x": 458,
      "y": 3798,
      "width": 307.52,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1986326060,
      "version": 1,
      "versionNonce": 185453836,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Most layers are windowed, a few\nsee everything.\nGemma 3 at 32k:\n  1/6 × 32768 + 5/6 × 1024\n  ≈ 6.3k token-equivalents\n  → ~650 MiB instead of 4 GiB\nGemma 2: 1:1, W = 4096.\ngpt-oss: alternating banded\n(W = 128) and dense layers.\nKeeps long-range recall via the\nglobal layers.",
      "originalText": "Most layers are windowed, a few\nsee everything.\nGemma 3 at 32k:\n  1/6 × 32768 + 5/6 × 1024\n  ≈ 6.3k token-equivalents\n  → ~650 MiB instead of 4 GiB\nGemma 2: 1:1, W = 4096.\ngpt-oss: alternating banded\n(W = 128) and dense layers.\nKeeps long-range recall via the\nglobal layers.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
