    {
      "id": "t2_23",
      "type": "text",
      "x": 880,
      "y": 3162,
      "width": 347.2,
      "height": 240.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1244959101,
      "version": 1,
      "versionNonce": 2016955140,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Asymmetric 4-bit with group scales.\nKey insight: outliers differ by\ntensor, so quantise\n  K per-channel (fixed outlier\n    channels)\n  V per-token\nNewest ~128 tokens stay in FP16\n(residual window) for accuracy.\n4k seq: ~136 MiB → ~450 seqs\n\nSmall loss; tuning-free, no\nretraining.",
      "originalText": "Asymmetric 4-bit with group scales.\nKey insight: outliers differ by\ntensor, so quantise\n  K per-channel (fixed outlier\n    channels)\n  V per-token\nNewest ~128 tokens stay in FP16\n(residual window) for accuracy.\n4k seq: ~136 MiB → ~450 seqs\n\nSmall loss; tuning-free, no\nretraining.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
