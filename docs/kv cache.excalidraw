      "updated": 1,
      "link": null,
      "locked": false,
      "text": "reserve max_len per request\n60–80% of KV memory wasted",
      "originalText": "reserve max_len per request\n60–80% of KV memory wasted",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_95",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_97",
      "type": "text",
      "x": 36,
      "y": 4414,
      "width": 337.28,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1065893541,
      "version": 1,
      "versionNonce": 48918605,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Old servers reserve max_len up\nfront: 8k tokens = 1 GiB / request\neven if the answer is 600 tokens.\nPlus fragmentation between\nrequests of different sizes.\n\nvLLM paper: only 20–38% of KV\nmemory held real tokens.\n60 GiB ÷ 1 GiB = 60 requests max.",
      "originalText": "Old servers reserve max_len up\nfront: 8k tokens = 1 GiB / request\neven if the answer is 600 tokens.\nPlus fragmentation between\nrequests of different sizes.\n\nvLLM paper: only 20–38% of KV\nmemory held real tokens.\n60 GiB ÷ 1 GiB = 60 requests max.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
