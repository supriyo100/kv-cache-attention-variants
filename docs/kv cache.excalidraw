    {
      "id": "t1_33",
      "type": "text",
      "x": 36,
      "y": 2050,
      "width": 337.28,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
