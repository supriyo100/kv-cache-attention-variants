    {
      "id": "t2_184",
      "type": "text",
      "x": 77.20000000000002,
      "y": 5540.75,
      "width": 285.59999999999997,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
