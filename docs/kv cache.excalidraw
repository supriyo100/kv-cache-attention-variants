      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "4 sink tokens + recent W\nfixed size, infinite stream",
      "originalText": "4 sink tokens + recent W\nfixed size, infinite stream",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_65",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_67",
      "type": "text",
      "x": 880,
      "y": 3798,
      "width": 347.2,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 26079132,
      "version": 1,
      "versionNonce": 394271226,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Models dump spare attention on the\nfirst tokens (sinks). Evicting them\nbreaks the softmax, so keep them:\n  cache = 4 sinks + last W tokens\nFixed memory for endless chats.\n\nLimit: tokens in the middle are\ngone; it cannot recall them.\nWorks post hoc; better if a sink\ntoken is trained in (gpt-oss).",
      "originalText": "Models dump spare attention on the\nfirst tokens (sinks). Evicting them\nbreaks the softmax, so keep them:\n  cache = 4 sinks + last W tokens\nFixed memory for endless chats.\n\nLimit: tokens in the middle are\ngone; it cannot recall them.\nWorks post hoc; better if a sink\ntoken is trained in (gpt-oss).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
