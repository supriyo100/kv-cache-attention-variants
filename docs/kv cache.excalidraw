      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_111",
      "type": "text",
      "x": 880,
      "y": 4414,
      "width": 337.28,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1923339014,
      "version": 1,
      "versionNonce": 680273083,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Static batches wait for the\nlongest request. Continuous\n(Orca-style) batching swaps\nfinished requests out and new ones\nin at every step.\nWith paging: 2–4× throughput.\n\nOut of blocks? Preempt a request:\nswap its KV to CPU, or drop and\nrecompute it later.",
      "originalText": "Static batches wait for the\nlongest request. Continuous\n(Orca-style) batching swaps\nfinished requests out and new ones\nin at every step.\nWith paging: 2–4× throughput.\n\nOut of blocks? Preempt a request:\nswap its KV to CPU, or drop and\nrecompute it later.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
