    {
      "id": "t2_103",
      "type": "text",
      "x": 514.5,
      "y": 4348.75,
      "width": 255.0,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
