      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_53",
      "type": "text",
      "x": 36,
      "y": 3798,
      "width": 367.04,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1181188031,
      "version": 1,
      "versionNonce": 378696920,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Each layer attends only to the last\nW tokens; older KV is dropped.\nCache is capped at W, whatever T is.\nAt 32k with W = 4096: 4 GiB → 512 MiB\n\nOlder info still flows upward:\nreceptive field ≈ L × W.\nUsed by: Mistral 7B (W = 4096).\nMust be trained in.",
      "originalText": "Each layer attends only to the last\nW tokens; older KV is dropped.\nCache is capped at W, whatever T is.\nAt 32k with W = 4096: 4 GiB → 512 MiB\n\nOlder info still flows upward:\nreceptive field ≈ L × W.\nUsed by: Mistral 7B (W = 4096).\nMust be trained in.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
