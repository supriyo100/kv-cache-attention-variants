      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "split KV along T across\nSMs, merge with log-sum-exp",
      "originalText": "split KV along T across\nSMs, merge with log-sum-exp",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_197",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_199",
      "type": "text",
      "x": 880,
      "y": 5606,
      "width": 317.44,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1094885345,
      "version": 1,
      "versionNonce": 714282423,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Decode has 1 query token, so\nparallelising over batch × heads\nleaves most of the 132 SMs idle.\nSplit each sequence's KV into\nchunks, one per SM, then combine\npartial softmaxes (log-sum-exp).\n\nUp to ~8× faster attention on\nlong contexts at small batch.",
      "originalText": "Decode has 1 query token, so\nparallelising over batch × heads\nleaves most of the 132 SMs idle.\nSplit each sequence's KV into\nchunks, one per SM, then combine\npartial softmaxes (log-sum-exp).\n\nUp to ~8× faster attention on\nlong contexts at small batch.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
