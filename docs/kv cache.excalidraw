      "versionNonce": 1727374732,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "load 512 MiB: ~8 ms (PCIe 5)\nrecompute 4k: ~100 ms",
      "originalText": "load 512 MiB: ~8 ms (PCIe 5)\nrecompute 4k: ~100 ms",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_123",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_125",
      "type": "text",
      "x": 1724,
      "y": 4414,
      "width": 317.44,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1439619218,
      "version": 1,
      "versionNonce": 1503112762,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Move cold KV down the hierarchy:\nHBM → CPU DRAM → local SSD →\nremote store. Bring it back when\nthe conversation resumes.\n4k-token prefill ≈ 2 × 8B × 4096\n  ≈ 66 TFLOP ≈ ~0.1 s on H100;\nloading is ~10× faster.\n\nTools: LMCache, Mooncake,\nNVIDIA Dynamo KVBM.",
      "originalText": "Move cold KV down the hierarchy:\nHBM → CPU DRAM → local SSD →\nremote store. Bring it back when\nthe conversation resumes.\n4k-token prefill ≈ 2 × 8B × 4096\n  ≈ 66 TFLOP ≈ ~0.1 s on H100;\nloading is ~10× faster.\n\nTools: LMCache, Mooncake,\nNVIDIA Dynamo KVBM.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
