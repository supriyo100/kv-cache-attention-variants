      "text": "keep top-attention tokens\n+ recent · e.g. 20% budget",
      "originalText": "keep top-attention tokens\n+ recent · e.g. 20% budget",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
