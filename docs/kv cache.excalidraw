      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "keep last W per layer\nW = 4096 → 512 MiB, 8× less",
      "originalText": "keep last W per layer\nW = 4096 → 512 MiB, 8× less",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
