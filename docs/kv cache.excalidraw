    {
      "id": "t2_169",
      "type": "text",
      "x": 1724,
      "y": 5010,
      "width": 327.36,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
