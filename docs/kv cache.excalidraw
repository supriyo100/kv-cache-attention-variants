    {
      "id": "t2_213",
      "type": "text",
      "x": 1724,
      "y": 5606,
      "width": 317.44,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
