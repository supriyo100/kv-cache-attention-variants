      "version": 1,
      "versionNonce": 121551641,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Track accumulated attention per\ntoken; keep the 'heavy hitters'\nplus a recent window, evict rest.\n20% budget at 32k:\n  4 GiB → ~820 MiB, 5× less\n\nLossy and irreversible: a token\nevicted now cannot come back if\na later question needs it.\nNo retraining.",
      "originalText": "Track accumulated attention per\ntoken; keep the 'heavy hitters'\nplus a recent window, evict rest.\n20% budget at 32k:\n  4 GiB → ~820 MiB, 5× less\n\nLossy and irreversible: a token\nevicted now cannot come back if\na later question needs it.\nNo retraining.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
