      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "architecture first,\neviction last",
      "originalText": "architecture first,\neviction last",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_86",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_88",
      "type": "text",
      "x": 2146,
      "y": 3798,
      "width": 307.52,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 857073158,
      "version": 1,
      "versionNonce": 1859426919,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Window / hybrid layers are part\nof the model: quality is what\nyou measured.\n\nPost-hoc eviction trades recall\nfor memory. Use it only after ②\nand ④ are exhausted, and test\nneedle-in-a-haystack recall.\nEviction also breaks exact\nprefix reuse (⑤).",
      "originalText": "Window / hybrid layers are part\nof the model: quality is what\nyou measured.\n\nPost-hoc eviction trades recall\nfor memory. Use it only after ②\nand ④ are exhausted, and test\nneedle-in-a-haystack recall.\nEviction also breaks exact\nprefix reuse (⑤).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_89",
      "type": "text",
      "x": 20,
      "y": 4152,
      "width": 815.92,
      "height": 35.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 62450099,
      "version": 1,
      "versionNonce": 816593494,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "④ Manage memory better — technique by technique",
      "originalText": "④ Manage memory better — technique by technique",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_90",
      "type": "text",
      "x": 20,
      "y": 4196,
      "width": 1495.44,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2027025151,
      "version": 1,
      "versionNonce": 1334364575,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Same model.  The cache size is fixed by ① and ②; ④ decides how much of the GPU actually holds useful tokens, and where the rest lives.",
      "originalText": "Same model.  The cache size is fixed by ① and ②; ④ decides how much of the GPU actually holds useful tokens, and where the rest lives.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_91",
