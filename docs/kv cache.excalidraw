      "updated": 1,
      "link": null,
      "locked": false,
      "text": "radix tree over tokens\nshares any common prefix",
      "originalText": "radix tree over tokens\nshares any common prefix",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_153",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_155",
      "type": "text",
      "x": 880,
      "y": 5010,
      "width": 337.28,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 235137414,
      "version": 1,
      "versionNonce": 891355530,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cached sequences form a radix\ntree; any branch point is shared:\nfew-shot prompts, multi-turn chat,\ntree-of-thought, agent loops.\nCache-aware scheduling runs the\nrequests with the longest cached\nprefix first.\n\nLarge gains on agentic workloads.",
      "originalText": "Cached sequences form a radix\ntree; any branch point is shared:\nfew-shot prompts, multi-turn chat,\ntree-of-thought, agent loops.\nCache-aware scheduling runs the\nrequests with the longest cached\nprefix first.\n\nLarge gains on agentic workloads.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
