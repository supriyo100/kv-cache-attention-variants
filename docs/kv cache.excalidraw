    {
      "id": "t2_81",
      "type": "text",
      "x": 1724,
      "y": 3798,
      "width": 317.44,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
