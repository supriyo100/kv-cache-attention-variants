      "versionNonce": 1653473922,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "4-bit E2M1 + FP8 scale / 16\n≈ 4.5 bit · ~36 KiB/token",
      "originalText": "4-bit E2M1 + FP8 scale / 16\n≈ 4.5 bit · ~36 KiB/token",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_35",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_37",
      "type": "text",
      "x": 1724,
      "y": 3162,
      "width": 307.52,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1119029167,
      "version": 1,
      "versionNonce": 1787529355,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Hardware-native 4-bit float:\nevery 16 values share an FP8\nscale (plus a per-tensor FP32).\n≈ 3.5× smaller than FP16.\n\nTensor cores read it directly,\nso no dequant kernel overhead.\nSupported in TensorRT-LLM.\nAccuracy close to FP8 on most\ntasks; check your workload.",
      "originalText": "Hardware-native 4-bit float:\nevery 16 values share an FP8\nscale (plus a per-tensor FP32).\n≈ 3.5× smaller than FP16.\n\nTensor cores read it directly,\nso no dequant kernel overhead.\nSupported in TensorRT-LLM.\nAccuracy close to FP8 on most\ntasks; check your workload.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
