      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "no T × T matrix in HBM\nmemory O(T), not O(T²)",
      "originalText": "no T × T matrix in HBM\nmemory O(T), not O(T²)",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_190",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_192",
      "type": "text",
      "x": 458,
      "y": 5606,
      "width": 307.52,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 275110883,
      "version": 1,
      "versionNonce": 426654818,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Tile Q, K, V into on-chip SRAM\nand use online softmax, so the\nT × T score matrix is never\nwritten to HBM. Exact, not an\napproximation.\n32k prompt: the score matrix\nalone would be 2 GiB per head.\nFA3 (Hopper): async TMA/WGMMA +\nFP8, ~75% of H100 peak.",
      "originalText": "Tile Q, K, V into on-chip SRAM\nand use online softmax, so the\nT × T score matrix is never\nwritten to HBM. Exact, not an\napproximation.\n32k prompt: the score matrix\nalone would be 2 GiB per head.\nFA3 (Hopper): async TMA/WGMMA +\nFP8, ~75% of H100 peak.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
