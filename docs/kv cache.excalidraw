    },
    {
      "id": "t2_74",
      "type": "text",
      "x": 1302,
      "y": 3798,
      "width": 327.36,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
