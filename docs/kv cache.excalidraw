      "versionNonce": 1097774410,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "bytes ↓ = tokens ↑\nkeeps every token",
      "originalText": "bytes ↓ = tokens ↑\nkeeps every token",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_42",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_44",
      "type": "text",
      "x": 2146,
      "y": 3162,
      "width": 327.36,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 198595994,
      "version": 1,
      "versionNonce": 78115987,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Halving bytes doubles concurrency\nat the same context, or doubles\ncontext at the same concurrency.\n\nOrder to try:\n  FP8 → NVFP4 (Blackwell)\n  → INT4 → INT2\nStacks with ① (fewer heads), ③\n(fewer tokens), ④ (paging).\nDecode also gets faster: fewer\nbytes to read each step (⑥).",
      "originalText": "Halving bytes doubles concurrency\nat the same context, or doubles\ncontext at the same concurrency.\n\nOrder to try:\n  FP8 → NVFP4 (Blackwell)\n  → INT4 → INT2\nStacks with ① (fewer heads), ③\n(fewer tokens), ④ (paging).\nDecode also gets faster: fewer\nbytes to read each step (⑥).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_45",
      "type": "text",
      "x": 20,
      "y": 3536,
      "width": 763.84,
      "height": 35.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1204684402,
      "version": 1,
      "versionNonce": 1577095342,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "③ Keep fewer tokens — technique by technique",
      "originalText": "③ Keep fewer tokens — technique by technique",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
