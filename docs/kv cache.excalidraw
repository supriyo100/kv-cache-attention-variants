      "versionNonce": 1809757505,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Per-token KV cache, all 32 layers, FP16  (× 4096 tokens in brackets)",
      "originalText": "Per-token KV cache, all 32 layers, FP16  (× 4096 tokens in brackets)",
      "fontSize": 24,
      "fontFamily": 1,
