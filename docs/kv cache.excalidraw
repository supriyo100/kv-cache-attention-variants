      "updated": 1,
      "link": null,
      "locked": false,
      "text": "requests join / leave\nevery decode step",
      "originalText": "requests join / leave\nevery decode step",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
