      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "prefill GPUs → KV transfer\n→ decode GPUs",
      "originalText": "prefill GPUs → KV transfer\n→ decode GPUs",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_130",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_132",
      "type": "text",
      "x": 2146,
      "y": 4414,
      "width": 337.28,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1065199387,
      "version": 1,
      "versionNonce": 1832864446,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Prefill is compute-bound, decode\nis memory-bound: run them on\nseparate GPU pools sized for each.\nKV moves over NVLink / RDMA\n(e.g. NIXL) after prefill.\n\nBetter TTFT and ITL at once.\nDistServe, Mooncake (Kimi),\nNVIDIA Dynamo, llm-d.",
      "originalText": "Prefill is compute-bound, decode\nis memory-bound: run them on\nseparate GPU pools sized for each.\nKV moves over NVLink / RDMA\n(e.g. NIXL) after prefill.\n\nBetter TTFT and ITL at once.\nDistServe, Mooncake (Kimi),\nNVIDIA Dynamo, llm-d.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_133",
      "type": "text",
      "x": 20,
      "y": 4748,
      "width": 729.12,
      "height": 35.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1481624592,
      "version": 1,
      "versionNonce": 1551061693,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "⑤ Don't recompute — technique by technique",
      "originalText": "⑤ Don't recompute — technique by technique",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_134",
      "type": "text",
      "x": 20,
      "y": 4792,
      "width": 1807.92,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 418668994,
      "version": 1,
      "versionNonce": 2083312366,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Same model.  A 4k-token shared prefix (system prompt, tools, RAG docs) costs ~66 TFLOP ≈ ~0.1 s of H100 prefill — paid again by every request unless it is cached.",
      "originalText": "Same model.  A 4k-token shared prefix (system prompt, tools, RAG docs) costs ~66 TFLOP ≈ ~0.1 s of H100 prefill — paid again by every request unless it is cached.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
