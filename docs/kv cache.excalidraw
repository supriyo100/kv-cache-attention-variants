      "roundness": null,
      "seed": 10113184,
      "version": 1,
      "versionNonce": 948567026,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Attention kernels that follow\nthe block table (④) directly,\nso paging costs ~nothing.\nCascade attention: requests that\nshare a prefix (⑤) read its KV\nonce for the whole batch, then\ntheir own suffix separately.\n\nUsed in vLLM and SGLang.",
      "originalText": "Attention kernels that follow\nthe block table (④) directly,\nso paging costs ~nothing.\nCascade attention: requests that\nshare a prefix (⑤) read its KV\nonce for the whole batch, then\ntheir own suffix separately.\n\nUsed in vLLM and SGLang.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
