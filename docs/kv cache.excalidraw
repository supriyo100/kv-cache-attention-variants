      "updated": 1,
      "link": null,
      "locked": false,
      "text": "split prompt into chunks\n(512–2k tokens / step)",
      "originalText": "split prompt into chunks\n(512–2k tokens / step)",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_116",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_118",
      "type": "text",
      "x": 1302,
      "y": 4414,
      "width": 327.36,
      "height": 200.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1400912018,
      "version": 1,
      "versionNonce": 2050117576,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A 32k prompt prefilled at once\nstalls every running decode.\nChunking mixes prompt chunks with\ndecode tokens in one batch:\n  • steady inter-token latency\n  • bounded activation memory\n  • KV filled block by block\n\nDefault on in recent vLLM and\nSGLang.",
      "originalText": "A 32k prompt prefilled at once\nstalls every running decode.\nChunking mixes prompt chunks with\ndecode tokens in one batch:\n  • steady inter-token latency\n  • bounded activation memory\n  • KV filled block by block\n\nDefault on in recent vLLM and\nSGLang.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
