    {
      "id": "t2_30",
      "type": "text",
      "x": 1302,
      "y": 3162,
      "width": 317.44,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1881861925,
      "version": 1,
      "versionNonce": 1468632008,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Same idea pushed to 2 bits.\nKVQuant adds:\n  • quantise keys BEFORE RoPE\n  • non-uniform (learned) levels\n  • keep rare outliers sparse,\n    in full precision\nReported: 1M-token context for\nLLaMA-7B on one A100-80GB.\n\nLoss becomes visible on hard\nlong-context tasks; validate.",
      "originalText": "Same idea pushed to 2 bits.\nKVQuant adds:\n  • quantise keys BEFORE RoPE\n  • non-uniform (learned) levels\n  • keep rare outliers sparse,\n    in full precision\nReported: 1M-token context for\nLLaMA-7B on one A100-80GB.\n\nLoss becomes visible on hard\nlong-context tasks; validate.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
