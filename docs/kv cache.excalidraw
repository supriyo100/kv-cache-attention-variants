      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "2 B/elem · 128 KiB/token\n~120 seqs @ 4k in 60 GiB",
      "originalText": "2 B/elem · 128 KiB/token\n~120 seqs @ 4k in 60 GiB",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "t2_7",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "t2_9",
      "type": "text",
      "x": 36,
      "y": 3162,
      "width": 337.28,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 848441985,
      "version": 1,
      "versionNonce": 429639932,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every K and V value takes 2 bytes.\nper token: 2 × 32 × 8 × 128 × 2 B\n  = 128 KiB\nper 4k sequence: 512 MiB\n60 GiB ÷ 512 MiB ≈ 120 sequences\n\nThis is the reference that every\nother card is measured against.",
      "originalText": "Every K and V value takes 2 bytes.\nper token: 2 × 32 × 8 × 128 × 2 B\n  = 128 KiB\nper 4k sequence: 512 MiB\n60 GiB ÷ 512 MiB ≈ 120 sequences\n\nThis is the reference that every\nother card is measured against.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
