    {
      "id": "t2_16",
      "type": "text",
      "x": 458,
      "y": 3162,
      "width": 347.2,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1424874272,
      "version": 1,
      "versionNonce": 357067904,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Store K, V as 8-bit floats with a\nper-tensor (or per-head) scale.\nper token: 64 KiB · 4k seq: 256 MiB\n→ twice the batch or context.\n\nNear-lossless on most models.\nNative on Hopper / Ada / Blackwell.\nvLLM: --kv-cache-dtype fp8\nAlso TensorRT-LLM, SGLang.\nFirst thing to turn on when\nserving: no retraining needed.",
      "originalText": "Store K, V as 8-bit floats with a\nper-tensor (or per-head) scale.\nper token: 64 KiB · 4k seq: 256 MiB\n→ twice the batch or context.\n\nNear-lossless on most models.\nNative on Hopper / Ada / Blackwell.\nvLLM: --kv-cache-dtype fp8\nAlso TensorRT-LLM, SGLang.\nFirst thing to turn on when\nserving: no retraining needed.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
