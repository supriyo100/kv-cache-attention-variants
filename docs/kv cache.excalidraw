    {
      "id": "t2_148",
      "type": "text",
      "x": 458,
      "y": 5010,
      "width": 347.2,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1545169884,
      "version": 1,
      "versionNonce": 351339773,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Each 16-token block is keyed by\nhash(parent hash, its tokens).\nNew request: walk its blocks, reuse\nevery hit, prefill only the rest.\nUnused blocks are evicted LRU.\n\nExact prefix only: one changed\ntoken early (a timestamp!)\ninvalidates everything after it.",
      "originalText": "Each 16-token block is keyed by\nhash(parent hash, its tokens).\nNew request: walk its blocks, reuse\nevery hit, prefill only the rest.\nUnused blocks are evicted LRU.\n\nExact prefix only: one changed\ntoken early (a timestamp!)\ninvalidates everything after it.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
