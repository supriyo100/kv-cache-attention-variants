  {
   "id": "e341",
   "type": "text",
   "x": 10,
   "y": 3996.75,
   "width": 646.6,
   "height": 85.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
