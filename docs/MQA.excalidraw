   "versionNonce": 1152337334,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Time lower bound = bytes / BW (A100: 1.555 TB/s), toy 100K, B=1\n  MHA 26.2 GB / 1.555 TB/s = 16.8 ms per token  (KV only)\n  GQA-8 6.55 GB             =  4.2 ms\n  MQA  0.82 GB              =  0.53 ms",
   "originalText": "Time lower bound = bytes / BW (A100: 1.555 TB/s), toy 100K, B=1\n  MHA 26.2 GB / 1.555 TB/s = 16.8 ms per token  (KV only)\n  GQA-8 6.55 GB             =  4.2 ms\n  MQA  0.82 GB              =  0.53 ms",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e340",
   "lineHeight": 1.25,
   "autoResize": true
  },
