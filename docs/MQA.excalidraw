  {
   "id": "e72",
   "type": "text",
   "x": 2060,
   "y": 249.0,
   "width": 489.1,
   "height": 135.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
