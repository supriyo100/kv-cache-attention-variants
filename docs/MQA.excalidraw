   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PROBLEM / TRADE-OFF\nReported: quality below MHA at equal params, sometimes\ntraining instability (GQA paper 2305.13245). Original MQA paper:\nlarge incremental-decoding speedup, minor loss at its scale.\nTensor parallel: with P > 1 GPUs the ONE K/V head is replicated\non each GPU, so per-GPU KV cannot shrink below 1 head.",
   "originalText": "PROBLEM / TRADE-OFF\nReported: quality below MHA at equal params, sometimes\ntraining instability (GQA paper 2305.13245). Original MQA paper:\nlarge incremental-decoding speedup, minor loss at its scale.\nTensor parallel: with P > 1 GPUs the ONE K/V head is replicated\non each GPU, so per-GPU KV cannot shrink below 1 head.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e373",
   "lineHeight": 1.25,
   "autoResize": true
  },
