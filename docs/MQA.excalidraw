   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SHARED\nK : (T,128)\nV : (T,128)\n\nevery head\nmultiplies its\nA_i against\nthe SAME V\nrows",
   "originalText": "SHARED\nK : (T,128)\nV : (T,128)\n\nevery head\nmultiplies its\nA_i against\nthe SAME V\nrows",
   "fontSize": 16,
