   "width": 442.59999999999997,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1362126470,
   "version": 1,
   "versionNonce": 859944004,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "K/V FLOPs in the projection also drop 32x:\n2 x 4096 x 128 vs 2 x 4096 x 4096 per token",
   "originalText": "K/V FLOPs in the projection also drop 32x:\n2 x 4096 x 128 vs 2 x 4096 x 4096 per token",
