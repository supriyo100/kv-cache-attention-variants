  {
   "id": "e280",
   "type": "text",
   "x": 10,
   "y": 2355.0,
   "width": 887.1999999999999,
   "height": 380.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1487628503,
   "version": 1,
   "versionNonce": 595251419,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "class MQA(nn.Module):\n  def __init__(s, d=4096, Hq=32, dh=128):\n    s.Hq, s.dh = Hq, dh\n    s.wq = nn.Linear(d, Hq * dh, bias=False)   # 4096 -> 4096\n    s.wk = nn.Linear(d, dh,      bias=False)   # 4096 -> 128   ONE head\n    s.wv = nn.Linear(d, dh,      bias=False)   # 4096 -> 128\n    s.wo = nn.Linear(Hq * dh, d, bias=False)   # 4096 -> 4096\n  def forward(s, x, cache):                    # x: (B, 1, 4096)\n    B = x.size(0)\n    q = s.wq(x).view(B,1,s.Hq,s.dh).transpose(1,2)   # (B,32,1,128)\n    k = s.wk(x).view(B,1,1,s.dh)                     # (B,1,1,128)\n    v = s.wv(x).view(B,1,1,s.dh)                     # (B,1,1,128)\n    K = torch.cat([cache.k, k], dim=2)               # (B,1,T,128)\n    V = torch.cat([cache.v, v], dim=2)               # (B,1,T,128)\n    att = (q @ K.transpose(-1,-2)) / s.dh**0.5       # (B,32,1,128)@(B,1,128,T) = (B,32,1,T)\n    p = att.softmax(-1)                              # (B,32,1,T)\n    o = p @ V                                        # (B,32,1,T)@(B,1,T,128) = (B,32,1,128)\n    o = o.transpose(1,2).reshape(B,1,s.Hq*s.dh)      # (B,1,4096)\n    return s.wo(o), (K, V)",
   "originalText": "class MQA(nn.Module):\n  def __init__(s, d=4096, Hq=32, dh=128):\n    s.Hq, s.dh = Hq, dh\n    s.wq = nn.Linear(d, Hq * dh, bias=False)   # 4096 -> 4096\n    s.wk = nn.Linear(d, dh,      bias=False)   # 4096 -> 128   ONE head\n    s.wv = nn.Linear(d, dh,      bias=False)   # 4096 -> 128\n    s.wo = nn.Linear(Hq * dh, d, bias=False)   # 4096 -> 4096\n  def forward(s, x, cache):                    # x: (B, 1, 4096)\n    B = x.size(0)\n    q = s.wq(x).view(B,1,s.Hq,s.dh).transpose(1,2)   # (B,32,1,128)\n    k = s.wk(x).view(B,1,1,s.dh)                     # (B,1,1,128)\n    v = s.wv(x).view(B,1,1,s.dh)                     # (B,1,1,128)\n    K = torch.cat([cache.k, k], dim=2)               # (B,1,T,128)\n    V = torch.cat([cache.v, v], dim=2)               # (B,1,T,128)\n    att = (q @ K.transpose(-1,-2)) / s.dh**0.5       # (B,32,1,128)@(B,1,128,T) = (B,32,1,T)\n    p = att.softmax(-1)                              # (B,32,1,T)\n    o = p @ V                                        # (B,32,1,T)@(B,1,T,128) = (B,32,1,128)\n    o = o.transpose(1,2).reshape(B,1,s.Hq*s.dh)      # (B,1,4096)\n    return s.wo(o), (K, V)",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e279",
   "lineHeight": 1.25,
   "autoResize": true
  },
