   "seed": 707950178,
   "version": 1,
   "versionNonce": 1366748639,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "O_i = softmax( Q_i K^T / sqrt(d_h) ) V            i = 1 .. 32,  d_h = 128\n\nQ_i       : (1, 128)       own projection  (decode: 1 query row)\nK         : (T, 128)       SAME for every i   [MHA: K_i differs]\nV         : (T, 128)       SAME for every i   [MHA: V_i differs]\nQ_i K^T   : (1,128)(128,T) = (1, T)    scores s_i\nA_i       = softmax(s_i / sqrt(128)) : (1, T)\nA_i V     : (1,T)(T,128)   = (1, 128)  = O_i\nconcat    : [O_1 .. O_32] : (1, 32 x 128) = (1, 4096)\nout       = concat W_o     : (1,4096)(4096,4096) = (1, 4096)",
   "originalText": "O_i = softmax( Q_i K^T / sqrt(d_h) ) V            i = 1 .. 32,  d_h = 128\n\nQ_i       : (1, 128)       own projection  (decode: 1 query row)\nK         : (T, 128)       SAME for every i   [MHA: K_i differs]\nV         : (T, 128)       SAME for every i   [MHA: V_i differs]\nQ_i K^T   : (1,128)(128,T) = (1, T)    scores s_i\nA_i       = softmax(s_i / sqrt(128)) : (1, T)\nA_i V     : (1,T)(T,128)   = (1, 128)  = O_i\nconcat    : [O_1 .. O_32] : (1, 32 x 128) = (1, 4096)\nout       = concat W_o     : (1,4096)(4096,4096) = (1, 4096)",
   "fontSize": 18,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e168",
   "lineHeight": 1.25,
   "autoResize": true
  },
