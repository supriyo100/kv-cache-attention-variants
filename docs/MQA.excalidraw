   "seed": 1803885801,
   "version": 1,
   "versionNonce": 961059551,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "K.expand(B,32,T,128).stride() = (T*128, 0, 128, 1)\n          stride 0 on the head axis -> all 32 heads\n          alias the same T x 128 block in memory\n\nnaive alternative:  K.repeat(1,32,1,1)  materialises\n          32 x T x 128 x 2 B  -> throws the saving away",
   "originalText": "K.expand(B,32,T,128).stride() = (T*128, 0, 128, 1)\n          stride 0 on the head axis -> all 32 heads\n          alias the same T x 128 block in memory\n\nnaive alternative:  K.repeat(1,32,1,1)  materialises\n          32 x T x 128 x 2 B  -> throws the saving away",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
