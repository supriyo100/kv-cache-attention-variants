   "versionNonce": 664876774,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "KEY INSIGHT\nQ heads stay 32 - only K and V collapse.\nEach head still has its own q_i, so each head can\nweigh the past differently, but all heads read\nthe SAME K and the SAME V.\nCache shrinks by H_q / H_kv = 32 / 1 = 32x.",
   "originalText": "KEY INSIGHT\nQ heads stay 32 - only K and V collapse.\nEach head still has its own q_i, so each head can\nweigh the past differently, but all heads read\nthe SAME K and the SAME V.\nCache shrinks by H_q / H_kv = 32 / 1 = 32x.",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "e71",
   "lineHeight": 1.25,
   "autoResize": true
  },
