  {
   "id": "e372",
   "type": "text",
   "x": 950,
   "y": 4344.5,
   "width": 499.00000000000006,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
